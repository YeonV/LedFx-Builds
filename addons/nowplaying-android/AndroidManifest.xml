<?xml version="1.0" encoding="utf-8"?>
<!--
  LedFx Now Playing addon: reads the device's active media session and sends it
  to the LedFx core on this device as `song_info` websocket messages - the same
  messages the desktop song detector sends.

  Kept out of the main LedFx APK on purpose: a notification listener is what
  turns Play Protect's verdict for a sideloaded LedFx into a hard block, so the
  main app ships without one and this small addon carries it alone.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ledfx.nowplaying">

    <!-- Only to reach the LedFx core on 127.0.0.1. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_media_play"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Granting notification access to this service is what permits
             MediaSessionManager.getActiveSessions(). Nothing reads the
             notifications themselves. -->
        <service
            android:name=".NowPlayingListenerService"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Only "ongoing" pre-checked on the grant screen: media sessions
                 are ongoing notifications, nothing else is needed. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="ongoing" />
        </service>
    </application>
</manifest>
