+            # property makes winrt lazily import the stream projection, and if
+            # winrt-Windows.Storage.Streams is missing that ModuleNotFoundError
+            # would otherwise escape.
+            from winrt.windows.storage.streams import DataReader
+
+            ref = getattr(props, "thumbnail", None)
+            if ref is None:
+                return None, None
+            stream = await ref.open_read_async()
+            size = getattr(stream, "size", 0) if stream is not None else 0
+            if not size:
+                return None, None
+            content_type = getattr(stream, "content_type", None) or "image/jpeg"
+            reader = DataReader(stream)
+            await reader.load_async(size)
+            data = bytes(bytearray(reader.read_buffer(size)))
