@@ -0,0 +1,286 @@
+"""Now Playing is opt-in, purges on opt-out, and feeds song_detected."""
+
+import io
+import os
+import time
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+from PIL import Image
+
+from ledfx.configuration.models import LedFxConfig
+from ledfx.core import LedFxCore
+from ledfx.events import Event
+from ledfx.nowplaying.models import TrackMetadata
+from ledfx.nowplaying.service import NowPlayingService
+from tests.test_utilities.fake_ledfx import fake_ledfx
+
+
+class _Events:
+    def __init__(self):
+        self.fired = []
+
+    def fire_event(self, event):
+        self.fired.append(event)
+
+    def of(self, event_type):
+        return [e for e in self.fired if e.event_type == event_type]
+
+
+class _Ledfx:
+    def __init__(self, config_dir=None):
+        fake = fake_ledfx()
+        self.config = fake.config
+        self.config_store = fake.config_store
+        self.events = _Events()
+        self.config_dir = config_dir
+
+
+def _png():
+    buf = io.BytesIO()
+    Image.new("RGB", (4, 4), color=(0, 128, 255)).save(buf, format="PNG")
+    return buf.getvalue()
+
+
+@pytest.fixture
+def ledfx(tmp_path):
+    return _Ledfx(config_dir=str(tmp_path))
+
+
+@pytest.fixture
+def service(ledfx):
+    svc = NowPlayingService(ledfx)
+    svc._art_resolver = MagicMock()
+    return svc
+
+
+def _track(position=None, playing=None, title="Song"):
+    return TrackMetadata(
+        source_id="smtc",
+        title=title,
+        artist="Artist",
+        album="Album",
+        position=position,
+        duration=200.0,
+        playing=playing,
+    )
+
+
+# ------------------------------------------------------------------
+# Opt-in switch
+# ------------------------------------------------------------------
+
+
+def test_now_playing_is_off_by_default():
+    config = LedFxConfig()
+    assert config.now_playing_enabled is False
+    assert config.now_playing.track_text.enabled is False
+    assert config.now_playing.album_art.enabled is False
+
+
+def test_opt_in_key_is_accepted_by_rest_and_needs_no_restart():
+    from ledfx.api.utils import PERMITTED_KEYS
+    from ledfx.configuration.models import RESTART_FIELDS
+
+    assert "now_playing_enabled" in PERMITTED_KEYS["core"]
+    assert "now_playing_enabled" not in RESTART_FIELDS
+
+
+def _core(enabled):
+    providers = [MagicMock(), MagicMock()]
+    core = SimpleNamespace(
+        config=LedFxConfig(now_playing_enabled=enabled),
+        _smtc_now_playing=providers[0],
+        _mpris_now_playing=providers[1],
+        now_playing=MagicMock(),
+    )
+    return core, providers
+
+
+def test_reconcile_starts_providers_only_when_enabled():
+    core, providers = _core(enabled=False)
+    LedFxCore.reconcile_now_playing_runtime(core, "startup")
+    for provider in providers:
+        provider.start.assert_not_called()
+        provider.stop.assert_called_once()
+    core.now_playing.purge.assert_called_once()
+
+    core, providers = _core(enabled=True)
+    LedFxCore.reconcile_now_playing_runtime(core, "startup")
+    for provider in providers:
+        provider.start.assert_called_once()
+    core.now_playing.purge.assert_not_called()
+
+
+def test_a_failing_provider_does_not_stop_the_others():
+    core, providers = _core(enabled=True)
+    providers[0].start.side_effect = RuntimeError("winrt exploded")
+    LedFxCore.reconcile_now_playing_runtime(core, "startup")
+    providers[1].start.assert_called_once()
+
+
+def test_base_config_update_reconciles():
+    core = SimpleNamespace(reconcile_now_playing_runtime=MagicMock())
+    core.setup_visualisation_events = MagicMock()
+    core.reconcile_sendspin_always_on_runtime = MagicMock()
+    LedFxCore.handle_base_configuration_update(
+        core, SimpleNamespace(config={"now_playing_enabled": True})
+    )
+    core.reconcile_now_playing_runtime.assert_called_once_with("base_config_update")
+
+
+async def test_info_reports_support_and_opt_in():
+    import sys
+
+    from ledfx.api.info import InfoEndpoint
+
+    endpoint = InfoEndpoint.__new__(InfoEndpoint)
+    endpoint._ledfx = SimpleNamespace(
+        http=SimpleNamespace(base_url="http://x"),
+        config=LedFxConfig(),
+        config_store=SimpleNamespace(error=None),
+        silence_scene=None,
+        now_playing=SimpleNamespace(enabled=True),
+    )
+    captured = {}
+
+    async def bare(payload):
+        captured.update(payload)
+
+    endpoint.bare_request_success = bare
+    await endpoint.get()
+    features = captured["features"]
+    assert features["now_playing_enabled"] is True
+    assert features["now_playing"] is (sys.platform in ("win32", "linux"))
+
+
+# ------------------------------------------------------------------
+# Purge
+# ------------------------------------------------------------------
+
+
+def test_purge_removes_cached_artwork_and_state(service, ledfx):
+    service.set_metadata("smtc", _track(), has_own_artwork=True)
+    service.set_artwork_bytes("smtc", _png(), "image/png")
+    artwork = service.get_current().artwork.cache_key
+    assert os.path.isfile(artwork)
+
+    service.purge()
+
+    assert not os.path.exists(artwork), "privacy switch must not leave the cover"
+    assert service.get_current().metadata is None
+    assert ledfx.events.of(Event.NOW_PLAYING_CLEARED), "clients must hear it"
+
+
+def test_service_reports_the_opt_in(service, ledfx):
+    assert service.enabled is False
+    ledfx.config.now_playing_enabled = True
+    assert service.enabled is True
+
+
+def test_purge_with_nothing_gathered_is_quiet(service, ledfx):
+    service.purge()
+    assert ledfx.events.fired == []
+
+
+def test_purge_keeps_the_gradient_variant(service):
+    service._state.selected_gradient_variant = "led_max"
+    service.purge()
+    assert service.get_current().selected_gradient_variant == "led_max"
+
+
+# ------------------------------------------------------------------
+# song_detected
+# ------------------------------------------------------------------
+
+
+def test_track_change_emits_song_detected(service, ledfx):
+    service.set_metadata("smtc", _track(position=12.0, playing=True))
+    (event,) = ledfx.events.of(Event.SONG_DETECTED)
+    assert (event.title, event.artist, event.album) == ("Song", "Artist", "Album")
+    assert event.position == 12.0 and event.duration == 200.0 and event.playing
+    assert event.timestamp is not None
+
+
+def test_no_timestamp_without_a_position(service, ledfx):
+    service.set_metadata("smtc", _track())
+    (event,) = ledfx.events.of(Event.SONG_DETECTED)
+    assert event.position is None and event.timestamp is None
+
+
+def test_steady_playback_sends_no_corrections(service, ledfx):
+    service.set_metadata("smtc", _track(position=10.0, playing=True))
+    anchor = service._emitted_timestamp
+    service._emitted_timestamp = anchor - 5
+    service.set_metadata("smtc", _track(position=15.0, playing=True))
+    assert len(ledfx.events.of(Event.SONG_DETECTED)) == 1
+
+
+def test_seek_sends_a_correction(service, ledfx):
+    service.set_metadata("smtc", _track(position=10.0, playing=True))
+    service.set_metadata("smtc", _track(position=90.0, playing=True))
+    assert len(ledfx.events.of(Event.SONG_DETECTED)) == 2
+
+
+def test_pause_sends_a_correction(service, ledfx):
+    service.set_metadata("smtc", _track(position=10.0, playing=True))
+    service.set_metadata("smtc", _track(position=10.1, playing=False))
+    assert ledfx.events.of(Event.SONG_DETECTED)[-1].playing is False
+
+
+def test_artwork_arrival_reemits_with_an_assets_relative_thumbnail(service, ledfx):
+    service.set_metadata("smtc", _track(), has_own_artwork=True)
+    service.set_artwork_bytes("smtc", _png(), "image/png")
+    event = ledfx.events.of(Event.SONG_DETECTED)[-1]
+    assert event.thumbnail == "now_playing/now_playing.png"
+
+
+def test_thumbnail_survives_a_symlinked_config_dir(tmp_path):
+    # Android reaches the app's files as /data/user/0/... and /data/data/...;
+    # the artwork path and config_dir can arrive spelled differently.
+    real = tmp_path / "real"
+    real.mkdir()
+    link = tmp_path / "link"
+    try:
+        os.symlink(real, link, target_is_directory=True)
+    except OSError:
