+# ------------------------------------------------------------------
+# Event-driven session selection (no retry timer)
+# ------------------------------------------------------------------
+
+
+class _WatchableSession(_FakeSession):
+    """A session whose property events can be fired by the test."""
+
+    def __init__(self, props=None, app_id="app"):
+        super().__init__(props=props)
+        self.source_app_user_model_id = app_id
+        self.callbacks = []
+        self.removed = 0
+
+    def add_media_properties_changed(self, cb):
+        self.callbacks.append(cb)
+        return _FakeToken()
+
+    def remove_media_properties_changed(self, tok):
+        self.removed += 1
+
+    def fire_properties_changed(self):
+        for cb in list(self.callbacks):
+            cb(self, None)
+
+
+class TestSMTCEventDrivenSelection:
+    @pytest.fixture
+    def scheduled(self, provider):
+        """Collect what WinRT callbacks schedule, instead of a real loop."""
+        coros = []
+        provider._loop = object()
+        provider._schedule = coros.append
+        return coros
+
+    async def _drain(self, coros):
+        while coros:
+            await coros.pop(0)
+
+    async def test_launcher_session_is_not_attached(self, provider, monkeypatch, ledfx):
+        launcher = _WatchableSession(_FakeProps(title="Game Launcher"), "launcher")
+        _inject_winrt_modules(monkeypatch, manager=_FakeManager(session=launcher))
+        await provider._initialize()
+        assert provider._session is None
+        assert provider._candidate is launcher, "must wait on its own events"
+        assert ledfx.now_playing.get_current().metadata is None
+
+    async def test_candidate_attaches_once_it_publishes_a_track(
+        self, provider, monkeypatch, ledfx, scheduled
+    ):
+        player = _WatchableSession(_FakeProps(), "player")
+        _inject_winrt_modules(monkeypatch, manager=_FakeManager(session=player))
+        await provider._initialize()
+        assert provider._session is None
+
+        player._props = _FakeProps(title="Song", artist="Artist", album="Album")
+        player.fire_properties_changed()
+        await self._drain(scheduled)
+
+        assert provider._session is player
+        assert provider._candidate is None
+        assert ledfx.now_playing.get_current().metadata.title == "Song"
+
+    async def test_sessions_changed_reselects(
+        self, provider, monkeypatch, ledfx, scheduled
+    ):
+        manager = _FakeManager(session=None)
+        _inject_winrt_modules(monkeypatch, manager=manager)
+        await provider._initialize()
+
+        manager._session = _WatchableSession(_FakeProps(title="Song", artist="Artist"))
+        manager.callbacks["sessions_changed"](manager, None)
+        await self._drain(scheduled)
+
+        assert provider._session is manager._session
+        assert ledfx.now_playing.get_current().metadata.artist == "Artist"
+
+    async def test_music_survives_a_launcher_taking_current(
+        self, provider, monkeypatch, ledfx, scheduled
+    ):
+        music = _WatchableSession(_FakeProps(title="Song", artist="Artist"), "player")
+        manager = _FakeManager(session=music)
+        _inject_winrt_modules(monkeypatch, manager=manager)
+        await provider._initialize()
+        assert provider._session is music
+
+        launcher = _WatchableSession(_FakeProps(title="Launcher"), "launcher")
+        manager._session = launcher
+        manager.callbacks["current_session_changed"](manager, None)
+        await self._drain(scheduled)
+
+        assert provider._session is music, "playing track must not be dropped"
+        assert provider._candidate is launcher
+        assert ledfx.now_playing.get_current().metadata.title == "Song"
+
+    async def test_stop_removes_every_subscription(self, provider, monkeypatch):
+        launcher = _WatchableSession(_FakeProps(title="Launcher"), "launcher")
+        manager = _FakeManager(session=launcher)
+        _inject_winrt_modules(monkeypatch, manager=manager)
+        await provider._initialize()
+
+        provider.stop()
+
+        assert sorted(manager.removed) == [
+            "current_session_changed",
+            "sessions_changed",
+        ]
+        assert launcher.removed == 1, "candidate watch must be released"
+        assert provider._candidate is None and provider._manager is None
+
+    async def test_manager_without_sessions_changed_still_works(
+        self, provider, monkeypatch, ledfx
+    ):
+        class _OldManager:
+            def __init__(self, session):
+                self._session = session
+
+            def get_current_session(self):
+                return self._session
+
+            def add_current_session_changed(self, cb):
+                return _FakeToken()
+
+            def remove_current_session_changed(self, tok):
+                pass
+
+        session = _WatchableSession(_FakeProps(title="Song", artist="Artist"))
+        _inject_winrt_modules(monkeypatch, manager=_OldManager(session))
+        await provider._initialize()
+        assert len(provider._manager_tokens) == 1
+        assert ledfx.now_playing.get_current().metadata.title == "Song"
+
+    def test_no_retry_timer_exists(self, provider):
