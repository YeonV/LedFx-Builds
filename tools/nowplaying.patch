+
+    async def _read_timing(self, session=None):
+        """Playback timing, read off the loop.
+
+        The WinRT calls are synchronous; on LedFx's loop they could stall the
+        loop itself. ``session`` defaults to the attached one; selection passes
+        a candidate it has not attached to yet.
+        """
