+"""Android production builds keep the console quiet (logcat bridge cost)."""
+
+import logging
+
+import pytest
+
+from ledfx.__main__ import setup_logging
+from ledfx.nowplaying.providers import android
+
+
+@pytest.fixture
+def console_level(monkeypatch, tmp_path):
+    root = logging.getLogger()
+    before = list(root.handlers)
+
+    def run(loglevel=None, on_android=True, dev_marker=False):
+        monkeypatch.setattr(android, "running_on_android", lambda: on_android)
+        if dev_marker:
+            (tmp_path / ".android_dev_logging").touch()
+        setup_logging(loglevel, str(tmp_path))
+        added = [h for h in root.handlers if h not in before]
+        console = [
+            h
+            for h in added
+            if isinstance(h, logging.StreamHandler)
+            and not isinstance(h, logging.FileHandler)
+        ]
+        files = [h for h in added if isinstance(h, logging.FileHandler)]
+        return console[0].level, [h.level for h in files]
+
+    yield run
+    for handler in [h for h in root.handlers if h not in before]:
+        root.removeHandler(handler)
+        handler.close()
+
+
+def test_android_production_console_is_silent(console_level):
+    console, files = console_level()
+    assert console > logging.CRITICAL
+    assert all(level == logging.INFO for level in files), "the log file keeps INFO"
+
+
+def test_dev_marker_restores_console_logging(console_level):
+    assert console_level(dev_marker=True)[0] == logging.WARNING
+
+
+def test_explicit_level_always_wins(console_level):
+    assert console_level(loglevel=logging.DEBUG)[0] == logging.DEBUG
+
+
+def test_desktop_is_unchanged(console_level):
+    assert console_level(on_android=False)[0] == logging.WARNING
