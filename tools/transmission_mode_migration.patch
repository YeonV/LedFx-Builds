diff --git a/tests/test_transmission_mode.py b/tests/test_transmission_mode.py
index c97212e..a6a515f 100644
--- a/tests/test_transmission_mode.py
+++ b/tests/test_transmission_mode.py
@@ -1,7 +1,37 @@
 """transmission_mode: changeable live, binary by default, migrated once."""
 
+import pytest
+
+from ledfx.configuration.migrations.builds import (
+    BUILD_CONFIGURATION_VERSION,
+    run_build_migrations,
+)
 from ledfx.configuration.models import RESTART_FIELDS
+from ledfx.consts import LEGACY_CONFIGURATION_VERSION
 
 
 def test_changing_it_needs_no_restart():
     assert "transmission_mode" not in RESTART_FIELDS
+
+
+@pytest.mark.parametrize(
+    ("version", "mode", "expected"),
+    [
+        ("2.3.6", "compressed", "binary_rgb"),  # upstream file, old default
+        (None, "compressed", "binary_rgb"),  # no version at all
+        ("2.3.6", "uncompressed", "uncompressed"),  # a deliberate choice
+        ("2.3.7", "compressed", "compressed"),  # chosen after the step ran
+    ],
+)
+def test_build_step(version, mode, expected):
+    raw = {"transmission_mode": mode}
+    if version is not None:
+        raw["configuration_version"] = version
+    data, changed = run_build_migrations(raw)
+    assert data["transmission_mode"] == expected
+    assert changed is (expected != mode)
+    assert raw["transmission_mode"] == mode, "the input is never mutated"
+
+
+def test_files_are_written_at_the_newest_build_step():
+    assert LEGACY_CONFIGURATION_VERSION == BUILD_CONFIGURATION_VERSION
