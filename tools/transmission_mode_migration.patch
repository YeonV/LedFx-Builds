diff --git a/ledfx/configuration/migrations/builds.py b/ledfx/configuration/migrations/builds.py
new file mode 100644
index 0000000..9d32ac3
--- /dev/null
+++ b/ledfx/configuration/migrations/builds.py
@@ -0,0 +1,56 @@
+"""LedFx-Builds config migrations, kept apart from the shared MIGRATIONS list.
+
+MIGRATIONS is upstream's numbered schema_version sequence ("append only"). A
+build-specific step appended there would take a number upstream may later
+give its own step, and the files of anyone switching between the two builds
+would then skip one or the other. These steps are gated on
+``configuration_version`` instead, which every config.json still carries and
+which upstream keeps frozen as LEGACY_CONFIGURATION_VERSION; this build writes
+the version of its newest step there (ledfx.consts).
+"""
+
+import copy
+import logging
+
+from packaging.version import InvalidVersion
+from packaging.version import parse as parse_version
+
+_LOGGER = logging.getLogger(__name__)
+
+
+def _older_than(raw: dict[str, object], version: str) -> bool:
+    found = raw.get("configuration_version")
+    if not isinstance(found, str):
+        return True
+    try:
+        return parse_version(found) < parse_version(version)
+    except InvalidVersion:
+        return True
+
+
+def transmission_mode_to_binary(raw: dict[str, object]) -> dict[str, object]:
+    """2.3.7: move users off base64 visualisation frames, once.
+
+    Measured on a Nexus 5 driving real LEDs: 16% off the audio thread and 14%
+    off total service CPU; on desktop ~11us per frame to encode against ~28us
+    for base64, shipping 31% fewer bytes. Only the old default is rewritten:
+    "uncompressed", or a choice made after this step ran, is left alone.
+    """
+    if raw.get("transmission_mode") != "compressed":
+        return raw
+    _LOGGER.warning("Migrating transmission_mode from compressed to binary_rgb")
+    return {**raw, "transmission_mode": "binary_rgb"}
+
+
+# (configuration_version the step brings a file to, step), oldest first.
+BUILD_MIGRATIONS = [("2.3.7", transmission_mode_to_binary)]
+BUILD_CONFIGURATION_VERSION = BUILD_MIGRATIONS[-1][0]
+
+
+def run_build_migrations(raw: dict[str, object]) -> tuple[dict[str, object], bool]:
+    """Apply the steps the file predates; returns (data, whether anything changed)."""
+    data = raw
+    for version, step in BUILD_MIGRATIONS:
+        if _older_than(raw, version):
+            data = step(copy.deepcopy(data) if data is raw else data)
+    return data, data != raw
