diff --git a/tests/test_boot_status.py b/tests/test_boot_status.py
new file mode 100644
index 0000000..359abb0
--- /dev/null
+++ b/tests/test_boot_status.py
@@ -0,0 +1,30 @@
+"""Startup writes boot_status.txt checkpoints for the Android splash screen."""
+
+import os
+from types import SimpleNamespace
+
+from ledfx.core import LedFxCore
+
+
+def test_stage_is_written_to_the_config_dir(tmp_path):
+    core = SimpleNamespace(config_dir=str(tmp_path))
+    LedFxCore._write_boot_stage(core, "loading_modules")
+    with open(os.path.join(tmp_path, "boot_status.txt")) as f:
+        assert f.read() == "loading_modules"
+
+
+def test_an_unwritable_dir_never_breaks_startup(tmp_path):
+    core = SimpleNamespace(config_dir=str(tmp_path / "missing" / "dir"))
+    LedFxCore._write_boot_stage(core, "starting")
+
+
+def test_stages_appear_in_startup_order():
+    import inspect
+
+    source = inspect.getsource(LedFxCore.async_start)
+    stages = ["starting", "loading_modules", "connecting_audio", "starting_server"]
+    positions = [source.index(f'_write_boot_stage("{stage}")') for stage in stages]
+    assert positions == sorted(positions)
+    assert source.index('_write_boot_stage("starting_server")') < source.index(
+        "await self.http.start("
+    )
