+++ b/tests/test_android_remote_submix_echo.py
@@ -0,0 +1,29 @@
+"""The Android app reads audio.android_remote_submix_echo from config.json."""
+
+import json
+
+import pytest
+from pydantic import ValidationError
+
+from ledfx.api.utils import PERMITTED_KEYS
+from ledfx.configuration.models import AudioConfig, LedFxConfig
+
+
+def test_defaults_to_auto():
+    assert AudioConfig().android_remote_submix_echo == "auto"
+
+
+@pytest.mark.parametrize("mode", ["auto", "on", "off"])
+def test_is_written_under_audio(mode):
+    config = LedFxConfig.model_validate({"audio": {"android_remote_submix_echo": mode}})
+    on_disk = json.loads(json.dumps(config.model_dump(mode="json")))
+    assert on_disk["audio"]["android_remote_submix_echo"] == mode
+
+
+def test_rejects_other_values():
+    with pytest.raises(ValidationError):
+        AudioConfig.model_validate({"android_remote_submix_echo": "loud"})
+
+
+def test_settable_over_rest():
+    assert "android_remote_submix_echo" in PERMITTED_KEYS["audio"]
