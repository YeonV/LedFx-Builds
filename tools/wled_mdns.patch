index 0000000..377dbd4
--- /dev/null
+++ b/tests/test_mdns_wled_address.py
@@ -0,0 +1,34 @@
+"""WLED discovery uses the address the mDNS reply carried (Android has no
+mDNS-aware resolver for the .local hostname)."""
+
+from unittest.mock import AsyncMock, MagicMock, patch
+
+from zeroconf import IPVersion
+
+from ledfx.mdns_manager import ZeroConfRunner
+
+
+async def _discover(addresses):
+    ledfx = MagicMock()
+    runner = ZeroConfRunner(ledfx)
+    with (
+        patch("ledfx.mdns_manager.AsyncServiceInfo") as info,
+        patch("ledfx.mdns_manager.async_fire_and_forget"),
+    ):
+        info.return_value.async_request = AsyncMock(return_value=True)
+        info.return_value.server = "wled-kitchen.local."
+        info.return_value.parsed_addresses.return_value = addresses
+        await runner.add_wled_device(MagicMock(), "_wled._tcp.local.", "x")
+        info.return_value.parsed_addresses.assert_called_once_with(IPVersion.V4Only)
+    return ledfx.devices.add_new_device.call_args.args
+
+
+async def test_the_reply_address_is_used():
+    assert await _discover(["192.168.1.40", "192.168.1.41"]) == (
+        "wled",
+        {"ip_address": "192.168.1.40"},
+    )
+
+
+async def test_hostname_when_the_reply_carried_no_address():
+    assert await _discover([]) == ("wled", {"ip_address": "wled-kitchen.local"})
