+"""AudioAnalyzer and the AudioAnalysisSource getters that expose it.
+
+Every value an effect can read must come straight from the analyzer's results
+for the latest block, through the same getters effects always used.
+"""
+
+import time
+
+import numpy as np
+import pytest
+
+from ledfx.configuration.models import AudioConfig
+from ledfx.effects.audio import AudioAnalysisSource
+from ledfx.effects.audio_analyzer import AudioAnalyzer
+from tests.test_utilities.fake_ledfx import fake_ledfx
+
+STREAM_RATE = 48000
+FPS = 60
+SECONDS = 10
+
+
+class FakeClock:
+    def __init__(self):
+        self.now = 1_000_000.0
+
+    def __call__(self):
+        return self.now
+
+    def tick(self):
+        self.now += 1 / FPS
+
+
+def make_signal():
+    """Tones, noise, a kick every half second and a silent stretch."""
+    rng = np.random.default_rng(1234)
+    n = STREAM_RATE * SECONDS
+    t = np.arange(n) / STREAM_RATE
+    signal = 0.15 * np.sin(2 * np.pi * 440 * t) + 0.1 * np.sin(2 * np.pi * 1760 * t)
+    signal += 0.03 * rng.standard_normal(n)
+    kick_len = int(0.15 * STREAM_RATE)
+    kick = np.exp(-np.arange(kick_len) / 3000.0) * np.sin(
+        2 * np.pi * 50 * np.arange(kick_len) / STREAM_RATE
+    )
+    for start in range(0, n - kick_len, STREAM_RATE // 2):
+        signal[start : start + kick_len] += kick
+    signal[4 * STREAM_RATE : 5 * STREAM_RATE] = 0.0
+    signal = np.clip(signal, -1, 1).astype(np.float32)
+    block = STREAM_RATE // FPS
+    return [signal[i : i + block] for i in range(0, n - block + 1, block)]
+
+
+def make_source(audio_config):
+    """AudioAnalysisSource set up as activation leaves it, without a device."""
+    src = object.__new__(AudioAnalysisSource)
+    src._ledfx = fake_ledfx({"audio": audio_config})
+    src._config = AudioConfig.model_validate(audio_config)
+    src._callbacks = []
+    src.initialise_analysis()
+    src._analyzer = src._create_analyzer()
+    src._callbacks = [src._publish_results]
+    return src
+
+
+def source_values(src):
+    """Everything an effect can read, through the effect-facing API."""
+    return {
+        "volume_raw": src.volume(filtered=False),
+        "volume_filtered": src.volume(filtered=True),
+        "melbanks": [m.copy() for m in src.melbanks.melbanks],
+        "melbanks_filtered": [m.copy() for m in src.melbanks.melbanks_filtered],
+        "pitch": src.pitch(),
+        "onset": src.onset(),
+        "bpm_beat_now": src.bpm_beat_now(),
+        "bar_oscillator": src.bar_oscillator(),
+        "beat_oscillator": src.beat_oscillator(),
+        "volume_beat_now": src.volume_beat_now(),
+        "beat_counter": src.beat_counter,
+        "tempo_bpm": src._tempo.get_bpm(),
+        "tempo_confidence": src._tempo.get_confidence(),
+        "powers": [
+            src.beat_power(),
+            src.bass_power(),
+            src.lows_power(),
+            src.mids_power(),
+            src.high_power(),
+            src.beat_power(filtered=False),
+            src.lows_power(filtered=False),
+        ],
+    }
+
+
+def analyzer_values(an):
+    def power(i, filtered=True):
+        value = an.freq_power_filtered[i] if filtered else an.freq_power_raw[i]
+        return value if not np.isnan(value) else 0.0
+
+    return {
+        "volume_raw": an.volume_raw,
+        "volume_filtered": an.volume_filtered,
+        "melbanks": [m.copy() for m in an.melbanks],
+        "melbanks_filtered": [m.copy() for m in an.melbanks_filtered],
+        "pitch": an.pitch,
+        "onset": an.onset,
+        "bpm_beat_now": an.bpm_beat_now,
+        "bar_oscillator": an.bar_oscillator,
+        "beat_oscillator": an.bar_oscillator % 1,
+        "volume_beat_now": an.volume_beat_now,
+        "beat_counter": an.beat_counter,
+        "tempo_bpm": an.tempo.get_bpm(),
+        "tempo_confidence": an.tempo.get_confidence(),
+        "powers": [
+            power(0),
+            power(1),
+            (power(0) + power(1)) * 0.5,
+            power(2),
+            power(3),
+            power(0, False),
+            (power(0, False) + power(1, False)) * 0.5,
+        ],
+    }
+
+
+def assert_same(expected, got, where):
+    for key, value in expected.items():
+        other = got[key]
+        if isinstance(value, list) and value and isinstance(value[0], np.ndarray):
+            for a, b in zip(value, other, strict=True):
+                np.testing.assert_array_equal(a, b, err_msg=f"{where} {key}")
+        else:
+            assert value == other, f"{where} {key}: {value!r} != {other!r}"
+
+
+def run(feed, values, blocks, clock):
+    rows = []
+    for block in blocks:
+        clock.tick()
+        feed(block)
+        rows.append(values())
+    return rows
+
+
+@pytest.mark.parametrize("delay_ms", [0, 50])
+def test_source_exposes_exactly_the_analyzer_results(monkeypatch, delay_ms):
+    audio_config = AudioConfig.model_validate({"delay_ms": delay_ms}).model_dump()
+    blocks = make_signal()
+    clock = FakeClock()
+    monkeypatch.setattr(time, "time", clock)
+
+    src = make_source(audio_config)
+    from_source = run(
+        lambda b: src._audio_sample_callback(b, 1, None, None),
+        lambda: source_values(src),
+        blocks,
+        clock,
+    )
+
+    clock.now = 1_000_000.0
+    melbank_configs = [entry["config"] for entry in src.melbanks.melbank_collection]
+    an = AudioAnalyzer(
+        audio_config, melbank_configs, src._ledfx.config.melbanks.coeffs_type
+    )
+    from_analyzer = run(an.process, lambda: analyzer_values(an), blocks, clock)
+
+    started = False
+    for i, (expected, got) in enumerate(zip(from_analyzer, from_source, strict=True)):
+        started = started or an.has_volume_measurement
+        if not src._has_volume_measurement:
+            continue
+        assert_same(expected, got, f"block {i}")
+    assert started
+
+
+def test_signal_exercises_every_detector(monkeypatch):
+    """Equality only means something if the detectors actually fire."""
+    clock = FakeClock()
+    monkeypatch.setattr(time, "time", clock)
+    src = make_source(AudioConfig.model_validate({}).model_dump())
+    seen = {"onset": 0, "volume_beat_now": 0, "bpm_beat_now": 0, "silent": 0}
+    for block in make_signal():
+        clock.tick()
+        src._audio_sample_callback(block, 1, None, None)
+        seen["onset"] += bool(src.onset())
+        seen["volume_beat_now"] += bool(src.volume_beat_now())
+        seen["bpm_beat_now"] += bool(src.bpm_beat_now())
+        seen["silent"] += not src.melbanks.melbanks[0].any()
+    assert all(seen.values()), seen
+
+
+def test_getters_before_any_audio():
+    src = make_source(AudioConfig.model_validate({}).model_dump())
+    assert src.volume() == -90
+    assert src.pitch() == 0
+    assert src.onset() is False
+    assert src.beat_power() == 0.0
+    assert src.bar_oscillator() == 0.0
+    assert src._tempo.get_bpm() == 0.0
+    assert src._has_volume_measurement is False
diff --git a/tests/test_audio_effect_lock.py b/tests/test_audio_effect_lock.py
new file mode 100644
index 0000000..a413bb8
--- /dev/null
+++ b/tests/test_audio_effect_lock.py
@@ -0,0 +1,136 @@
+"""An effect's audio update never waits for its render thread.
+
+The render thread holds the effect lock for a whole frame. The thread that
+delivers audio results (the audio callback, or the audio process reader)
+updates every active effect in turn, so waiting on one effect's lock held up
+all the others behind it. Now a busy lock defers the update to the start of
+that effect's next frame, with the newest results and every missed event.
+"""
+
+import threading
+import time
+
+from ledfx.effects import Effect
+from ledfx.effects.audio import AudioReactiveEffect
+
+
+class FakeAudio:
+    def __init__(self):
+        self.flags = {"onset": False, "bpm_beat_now": False, "volume_beat_now": False}
+        self.pitch_value = 0.0
+
+    def onset(self):
+        return self.flags["onset"]
+
+    def bpm_beat_now(self):
+        return self.flags["bpm_beat_now"]
+
+    def volume_beat_now(self):
+        return self.flags["volume_beat_now"]
+
+    def pitch(self):
+        return self.pitch_value
+
+
+class FakeMelbank:
+    def cache_clear(self):
+        pass
+
+
+class FakeLogSec:
+    def log_sec(self, now):
+        pass
+
+    def try_log(self):
+        return False
+
+
+@Effect.no_registration
+class Recorder(AudioReactiveEffect):
+    def audio_data_updated(self, data):
+        self.updates.append(
+            (data.pitch(), data.onset(), data.bpm_beat_now(), data.volume_beat_now())
+        )
+
+    def render(self):
+        self.frames += 1
+
+    def __del__(self):
+        pass  # built without activate(), so there is nothing to deactivate
+
+
+def make_effect():
+    effect = Recorder.__new__(Recorder)
+    effect.lock = threading.Lock()
+    effect.audio = FakeAudio()
+    effect.melbank = FakeMelbank()
+    effect.logsec = FakeLogSec()
+    effect._last_frame_time = time.perf_counter()
+    effect._active = True
+    effect._audio_pending = False
+    effect._missed_events = set()
+    effect._pending_lock = threading.Lock()
+    effect.updates = []
+    effect.frames = 0
+    return effect
+
+
+def deliver(effect, pitch, **flags):
+    effect.audio.pitch_value = pitch
+    effect.audio.flags = {
+        "onset": False,
+        "bpm_beat_now": False,
+        "volume_beat_now": False,
+        **flags,
+    }
+    effect._audio_data_updated()
+
+
+def test_free_lock_updates_at_once_as_before():
+    effect = make_effect()
+    deliver(effect, 1.0, onset=True)
+    assert effect.updates == [(1.0, True, False, False)]
+    assert not effect._audio_pending
+
+
+def test_busy_lock_returns_at_once_and_render_applies_newest_with_missed_events():
+    effect = make_effect()
+    effect.lock.acquire()  # the render thread is mid-frame
+    try:
+        started = time.perf_counter()
+        deliver(effect, 1.0, onset=True)
+        deliver(effect, 2.0, bpm_beat_now=True)
+        deliver(effect, 3.0)
+        assert time.perf_counter() - started < 0.1
+        assert effect.updates == []
+        assert effect._audio_pending
+    finally:
+        effect.lock.release()
+
+    effect._render()
+    # Newest values, and both events from the blocks it missed.
+    assert effect.updates == [(3.0, True, True, False)]
+    assert effect.frames == 1
+    assert not effect._audio_pending
+
+    # The missed events are reported once, not again on the next update.
+    deliver(effect, 4.0)
+    assert effect.updates[-1] == (4.0, False, False, False)
+
+
+def test_missed_events_carry_into_an_update_the_reader_makes_itself():
+    """Render had no frame in between: the next free update merges them."""
+    effect = make_effect()
+    effect.lock.acquire()
+    deliver(effect, 1.0, volume_beat_now=True)
+    effect.lock.release()
+    deliver(effect, 2.0)
+    assert effect.updates == [(2.0, False, False, True)]
+    assert not effect._audio_pending
+
+
+def test_render_without_pending_audio_does_not_update():
+    effect = make_effect()
+    effect._render()
+    assert effect.updates == []
+    assert effect.frames == 1
diff --git a/tests/test_audio_process.py b/tests/test_audio_process.py
new file mode 100644
index 0000000..4130164
--- /dev/null
+++ b/tests/test_audio_process.py
@@ -0,0 +1,397 @@
+"""The audio process: framing, the worker's commands, and a real spawned
+process whose results must equal in-process analysis exactly."""
+
+import socket
+import threading
+import time
+
+import pytest
+
+from ledfx.audio_process import client as client_module
+from ledfx.audio_process import protocol
+from ledfx.audio_process.client import AudioProcessClient, AudioProcessError
+from ledfx.audio_process.worker import AudioWorker
+from ledfx.configuration.models import AudioConfig
+from ledfx.effects.audio_analyzer import AudioAnalyzer, SnapshotView
+from tests.test_audio_analyzer import (
+    FakeClock,
+    analyzer_values,
+    assert_same,
+    make_signal,
+    make_source,
+)
+
+# -- protocol -------------------------------------------------------------
+
+
+def roundtrip(message):
+    a, b = socket.socketpair()
+    try:
+        protocol.send(a, message)
+        return protocol.recv(b)
+    finally:
+        a.close()
+        b.close()
+
+
+def test_protocol_roundtrip_with_nested_blobs():
+    message = {
+        "t": "snapshot",
+        "s": {
+            "x": 1.5,
+            "flags": [True, False],
+            "melbanks": [b"\x00\x01", b""],
+            "n": None,
+        },
+        "data": bytearray(b"abc"),
+    }
+    got = roundtrip(message)
+    assert got["s"]["melbanks"] == [b"\x00\x01", b""]
+    assert got["data"] == b"abc"
+    assert got["s"]["x"] == 1.5
+    assert got["s"]["flags"] == [True, False]
+    assert got["s"]["n"] is None
+
+
+def test_protocol_rejects_dangling_blob_reference():
+    a, b = socket.socketpair()
+    try:
+        header = b'{"x":{"__blob__":3}}'
+        body = protocol._LEN.pack(len(header)) + header + protocol._LEN.pack(0)
+        a.sendall(protocol._LEN.pack(len(body)) + body)
+        with pytest.raises(protocol.ProtocolError):
+            protocol.recv(b)
+    finally:
+        a.close()
+        b.close()
+
+
+def test_protocol_rejects_a_body_that_does_not_match_its_fields():
+    header = b'{"x":1}'
+    body = protocol._LEN.pack(len(header)) + header + protocol._LEN.pack(1)
+    with pytest.raises(protocol.ProtocolError):
+        protocol.decode(body)  # announces one blob, carries none
+    with pytest.raises(protocol.ProtocolError):
+        protocol.decode(body[:-4] + protocol._LEN.pack(0) + b"extra")
+
+
+class CountingSocket:
+    def __init__(self, sock):
+        self._sock = sock
+        self.reads = 0
+
+    def recv_into(self, *args):
+        self.reads += 1
+        return self._sock.recv_into(*args)
+
+
+def test_protocol_reads_a_whole_snapshot_in_two_reads():
+    """Every socket read gives up the interpreter lock, and in a busy LedFx
+    getting it back costs up to a switch interval, so reads per message are
+    what a snapshot costs the reader there."""
+    a, b = socket.socketpair()
+    try:
+        protocol.send(a, {"t": "snapshot", "s": base_snapshot()})
+        counting = CountingSocket(b)
+        got = protocol.recv(counting)
+        assert got["t"] == "snapshot"
+        assert len(got["s"]["melbanks"]) > 0
+        assert counting.reads == 2
+    finally:
+        a.close()
+        b.close()
+
+
+def test_protocol_reports_closed_peer():
+    a, b = socket.socketpair()
+    a.close()
+    with pytest.raises(ConnectionError):
+        protocol.recv(b)
+    b.close()
+
+
+# -- snapshot -------------------------------------------------------------
+
+
+def test_snapshot_view_carries_every_result_exactly():
+    clock = FakeClock()
+    config = AudioConfig.model_validate({}).model_dump()
+    src = make_source(config)
+    an = AudioAnalyzer(*src._analyzer_args())
+    for block in make_signal()[:200]:
+        clock.tick()
+        if an.process(block):
+            view = SnapshotView(roundtrip({"s": an.snapshot()})["s"])
+            assert_same(analyzer_values(an), analyzer_values(view), "snapshot")
+
+
+# -- worker commands (in a thread, fake audio module) ------------------------
+
+
+class FakeStream:
+    def __init__(self, **kwargs):
+        self.kwargs = kwargs
+        self.started = False
+
+    def start(self):
+        self.started = True
+
+    def stop(self):
+        self.started = False
+
+    def close(self):
+        pass
+
+
+class FakeSounddevice:
+    def __init__(self):
+        self.opened = []
+
+    def query_hostapis(self):
+        return [{"name": "MME"}, {"name": "Windows WASAPI"}]
+
+    def query_devices(self):
+        return [
+            {"name": "Speakers", "hostapi": 0, "max_input_channels": 0},
+            {"name": "Microphone", "hostapi": 1, "max_input_channels": 1},
+            {"name": "Line In", "hostapi": 1, "max_input_channels": 2},
+        ]
+
+    def InputStream(self, **kwargs):
+        stream = FakeStream(**kwargs)
+        self.opened.append(stream)
+        return stream
+
+
+def worker_pair():
+    a, b = socket.socketpair()
+    sd = FakeSounddevice()
+    w = AudioWorker(b, sd)
+    t = threading.Thread(target=w.serve, daemon=True)
+    t.start()
+    return a, sd, t
+
+
+def test_worker_opens_device_by_name_when_index_drifted():
+    a, sd, t = worker_pair()
+    protocol.send(
+        a,
+        {
+            "t": "open",
+            "id": 1,
+            "device": 1,
+            "device_name": "Windows WASAPI: Line In",
+            "samplerate": 48000,
+            "blocksize": 800,
+            "channels": 1,
+        },
+    )
+    reply = protocol.recv(a)
+    assert reply == {"t": "opened", "id": 1, "device": 2}
+    assert sd.opened[0].kwargs["device"] == 2
+    assert sd.opened[0].started
+    protocol.send(a, {"t": "quit"})
+    a.close()
+    t.join(3)
+
+
+def test_worker_refuses_unknown_device_instead_of_another():
+    a, sd, t = worker_pair()
+    protocol.send(
+        a,
+        {
+            "t": "open",
+            "id": 7,
+            "device": 1,
+            "device_name": "Windows WASAPI: Gone",
+            "samplerate": 48000,
+            "blocksize": 800,
+            "channels": 1,
+        },
+    )
+    reply = protocol.recv(a)
+    assert reply["t"] == "open_failed"
+    assert reply["id"] == 7
+    assert "Gone" in reply["error"]
+    assert sd.opened == []
+    a.close()
+    t.join(3)
+
+
+# -- token ----------------------------------------------------------------
+
+
+def test_client_rejects_a_connection_without_the_token(monkeypatch):
+    """Something else connects first; only the real worker is accepted."""
+    started = {}
+
+    def launcher(port, token):
+        def connect():
+            intruder = socket.create_connection(("127.0.0.1", port))
+            protocol.send(intruder, {"t": "hello", "token": "wrong"})
+            started["intruder"] = intruder
+            real = socket.create_connection(("127.0.0.1", port))
+            protocol.send(real, {"t": "hello", "token": token})
+            started["real"] = real
+
+        threading.Thread(target=connect, daemon=True).start()
+
+    monkeypatch.setattr(client_module, "_launcher", launcher)
+    c = AudioProcessClient(lambda view: None)
+    c.start(timeout=5)
+    try:
+        assert c.alive
+        # The intruder was closed by the client.
+        started["intruder"].settimeout(3)
+        assert started["intruder"].recv(1) == b""
+    finally:
+        c.stop()
+        started["real"].close()
+
+
+def test_client_gives_up_when_nothing_connects(monkeypatch):
+    monkeypatch.setattr(client_module, "_launcher", lambda port, token: None)
+    c = AudioProcessClient(lambda view: None)
+    with pytest.raises(AudioProcessError):
+        c.start(timeout=0.5)
+
+
+# -- a real audio process -------------------------------------------------------
+
+
+def test_spawned_process_matches_in_process_analysis_exactly(monkeypatch):
+    """Blocks go to a real separate interpreter and come back as results that
+    the source's getters expose identically to in-process analysis.
+
+    time.time is not shared with the child, so values that depend on the wall
+    clock (bar oscillator, volume beat) are left out here; the in-process
+    tests cover them with a fake clock.
+    """
+    config = AudioConfig.model_validate({}).model_dump()
+    blocks = make_signal()[:240]
+
+    local = AudioAnalyzer(*make_source(config)._analyzer_args())
+    expected = []
+    for block in blocks:
+        if local.process(block):
+            expected.append(analyzer_values(local))
+
+    src = make_source(config)
+    got = []
+    arrived = threading.Event()
+
+    def on_results(view):
+        src._apply_results(view)
+        got.append(clock_free(source_like(src)))
+        arrived.set()
+
+    c = AudioProcessClient(on_results)
+    c.start()
+    try:
+        c.configure(*src._analyzer_args())
+        for block in blocks:
+            arrived.clear()
+            before = len(got)
+            c.push(block)
+            # Wait for this block's result, or for nothing (first block is
+            # swallowed by the resampler), before sending the next.
+            arrived.wait(2)
+            assert len(got) - before in (0, 1)
+    finally:
+        c.stop()
+
+    assert len(got) == len(expected) > 200
+    for i, (e, g) in enumerate(zip(expected, got, strict=True)):
+        assert_same(clock_free(e), g, f"block {i}")
+
+
+CLOCK_DEPENDENT = ("bar_oscillator", "beat_oscillator", "volume_beat_now")
+
+
+def clock_free(values):
+    return {k: v for k, v in values.items() if k not in CLOCK_DEPENDENT}
+
+
+def source_like(src):
+    from tests.test_audio_analyzer import source_values
+
+    return source_values(src)
+
+
+def base_snapshot():
+    an = AudioAnalyzer(
+        *make_source(AudioConfig.model_validate({}).model_dump())._analyzer_args()
+    )
+    for block in make_signal()[:5]:
+        an.process(block)
+    return an.snapshot()
+
+
+def nothing_arrives(sock, wait=0.3):
+    sock.settimeout(wait)
+    try:
+        sock.recv(1)
+    except TimeoutError:
+        return True
+    finally:
+        sock.settimeout(None)
+    return False
+
+
+def test_worker_sends_only_the_newest_snapshot_when_asked():
+    """A reader that is behind gets fresh values and every event, never a
+    backlog: unasked snapshots replace each other, flags ORed together."""
+    a, b = socket.socketpair()
+    w = AudioWorker(b, FakeSounddevice())
+    t = threading.Thread(target=w.serve, daemon=True)
+    t.start()
+    base = base_snapshot()
+    w._offer(dict(base, onset=True, bpm_beat_now=False, volume_beat_now=False, pitch=1.0))
+    w._offer(dict(base, onset=False, bpm_beat_now=True, volume_beat_now=False, pitch=2.0))
+    assert nothing_arrives(a)
+
+    protocol.send(a, {"t": "next"})
+    s = protocol.recv(a)["s"]
+    assert s["pitch"] == 2.0
+    assert (s["onset"], s["bpm_beat_now"], s["volume_beat_now"]) == (True, True, False)
+
+    # Asked once, sent once: the next snapshot waits for the next request.
+    w._offer(dict(base, onset=False, bpm_beat_now=False, volume_beat_now=False, pitch=3.0))
+    assert nothing_arrives(a)
+    protocol.send(a, {"t": "next"})
+    s = protocol.recv(a)["s"]
+    assert s["pitch"] == 3.0
+    assert (s["onset"], s["bpm_beat_now"], s["volume_beat_now"]) == (False, False, False)
+    protocol.send(a, {"t": "quit"})
+    a.close()
+    t.join(3)
+    assert not t.is_alive()
+
+
+def test_reader_asks_for_the_next_snapshot_before_handling_this_one():
+    a, b = socket.socketpair()
+    handling = threading.Event()
+    release = threading.Event()
+    seen = []
+
+    def on_results(view):
+        seen.append(view)
+        handling.set()
+        release.wait(3)
+
+    c = AudioProcessClient(on_results)
+    c._sock = b
+    c.alive = True
+    reader = threading.Thread(target=c._read_loop, daemon=True)
+    reader.start()
+    protocol.send(a, {"t": "snapshot", "s": dict(base_snapshot(), pitch=5.0)})
+    # on_results blocks until release; a request sent only after it would
+    # miss this timeout.
+    a.settimeout(1)
+    assert protocol.recv(a) == {"t": "next"}
+    a.settimeout(None)
+    assert handling.wait(3)
+    release.set()
+    a.close()
+    reader.join(3)
+    assert [v.pitch for v in seen] == [5.0]
