+"""Android Playback Capture control (MediaProjection-based system audio).
+
+Exposes the real capture state and a revoke action here, in the actual REST
+API, rather than through the Android JS bridge's equivalent check. The
+bridge's hasPlaybackCapture() runs in the Activity process and reads
+PythonService's static consent fields there - but only PythonService's own
+broadcast receiver, running in the :service_ledfx process, ever sets them.
+Android does not share static state across process boundaries, so the
+bridge check can never reflect reality; it reads a copy that is never
+written. The actual AndroidPlaybackCapture object lives entirely in this
+process (see _pipeline_android/src/android_playback_capture.py), so this
+endpoint asks it directly instead.
+"""
+
+import logging
+
+from aiohttp import web
+
+from ledfx.api import RestEndpoint
+from ledfx.nowplaying.providers.android import running_on_android
+
+_LOGGER = logging.getLogger(__name__)
+
+
+def _capture_class():
+    """The Android-only capture class, or None off-Android / off-Android-build."""
+    try:
+        import android_playback_capture
+
+        return android_playback_capture.AndroidPlaybackCapture
+    except Exception:  # noqa: BLE001 - also JNI errors, not only ImportError
+        return None
+
+
+class AndroidCaptureEndpoint(RestEndpoint):
+    """REST endpoint for Android Playback Capture (system audio) state.
+
+    GET /api/android/playback_capture
+        Whether a live, still-valid MediaProjection capture is held.
+
+    DELETE /api/android/playback_capture
+        Revoke: ends the real MediaProjection session (not just LedFx's
+        cached reference to it), so the system's own status-bar recording
+        indicator clears as a direct consequence. Resuming afterward needs
+        a fresh consent dialog - unlike switching to a different audio
+        input and back, which reuses the cached session for free.
+    """
+
+    ENDPOINT_PATH = "/api/android/playback_capture"
+
+    async def get(self) -> web.Response:
+        capture = _capture_class()
+        active = bool(capture and running_on_android() and capture.is_active())
+        return await self.bare_request_success({"active": active})
+
+    async def delete(self) -> web.Response:
+        capture = _capture_class()
+        if capture and running_on_android():
+            capture.revoke()
+        return await self.bare_request_success({"active": False})
diff --git a/tests/test_api_android_capture.py b/tests/test_api_android_capture.py
new file mode 100644
index 0000000..dca5ebf
--- /dev/null
+++ b/tests/test_api_android_capture.py
@@ -0,0 +1,70 @@
+"""/api/android/playback_capture asks the in-process capture object."""
+
+import sys
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+import ledfx.api.android_capture as endpoint_module
+from ledfx.api.android_capture import AndroidCaptureEndpoint
+
+
+@pytest.fixture
+def endpoint():
+    ep = AndroidCaptureEndpoint.__new__(AndroidCaptureEndpoint)
+    sent = []
+
+    async def bare(payload):
+        sent.append(payload)
+        return payload
+
+    ep.bare_request_success = bare
+    return ep, sent
+
+
+@pytest.fixture
+def capture(monkeypatch):
+    state = SimpleNamespace(active=True, revoked=0)
+
+    class AndroidPlaybackCapture:
+        @classmethod
+        def is_active(cls):
+            return state.active
+
+        @classmethod
+        def revoke(cls):
+            state.revoked += 1
+            state.active = False
+
+    module = ModuleType("android_playback_capture")
+    module.AndroidPlaybackCapture = AndroidPlaybackCapture
+    monkeypatch.setitem(sys.modules, "android_playback_capture", module)
+    monkeypatch.setattr(endpoint_module, "running_on_android", lambda: True)
+    return state
+
+
+async def test_reports_a_live_capture(endpoint, capture):
+    ep, _ = endpoint
+    assert await ep.get() == {"active": True}
+
+
+async def test_delete_revokes_the_real_session(endpoint, capture):
+    ep, _ = endpoint
+    assert await ep.delete() == {"active": False}
+    assert capture.revoked == 1
+    assert await ep.get() == {"active": False}
+
+
+async def test_off_android_is_inactive_and_delete_is_harmless(endpoint, monkeypatch):
+    monkeypatch.setitem(sys.modules, "android_playback_capture", None)
+    ep, _ = endpoint
+    assert await ep.get() == {"active": False}
+    assert await ep.delete() == {"active": False}
+
+
+def test_is_registered_on_the_v1_api():
+    from ledfx.api import RestEndpoint
+
+    assert "/api/android/playback_capture" in {
+        cls.ENDPOINT_PATH for cls in RestEndpoint.registry().values()
+    }
