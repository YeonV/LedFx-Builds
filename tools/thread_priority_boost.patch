diff --git a/ledfx/nowplaying/providers/android.py b/ledfx/nowplaying/providers/android.py
index f4d758d..de50fa6 100644
--- a/ledfx/nowplaying/providers/android.py
+++ b/ledfx/nowplaying/providers/android.py
@@ -91,6 +91,26 @@ def running_on_android() -> bool:
     return android_context() is not None
 
 
+def boost_current_thread(role: str) -> None:
+    """Raise the calling thread to THREAD_PRIORITY_AUDIO on Android.
+
+    The render loop and the asyncio event loop are the real-time halves of an
+    audio-reactive pipeline, yet at Android's default priority they compete
+    with ordinary background workers. AudioRecord already runs at this priority
+    natively; measured on-device, matching it was the single biggest win of the
+    b38 investigation. A no-op everywhere else.
+    """
+    if not running_on_android():
+        return
+    try:
+        from jnius import autoclass
+
+        process = autoclass("android.os.Process")
+        process.setThreadPriority(process.THREAD_PRIORITY_AUDIO)
+    except Exception:
+        _LOGGER.exception("Android: failed to raise %s thread priority", role)
+
+
 def notification_access_granted() -> bool:
     """Has the user granted LedFx notification access?
 
