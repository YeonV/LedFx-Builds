diff --git a/tests/test_android_thread_priority.py b/tests/test_android_thread_priority.py
new file mode 100644
index 0000000..6cb6504
--- /dev/null
+++ b/tests/test_android_thread_priority.py
@@ -0,0 +1,57 @@
+"""Render and event-loop threads run at THREAD_PRIORITY_AUDIO on Android."""
+
+import inspect
+import logging
+import sys
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+from ledfx.nowplaying.providers import android
+
+
+@pytest.fixture
+def process(monkeypatch):
+    calls = []
+    fake = SimpleNamespace(THREAD_PRIORITY_AUDIO=-16, setThreadPriority=calls.append)
+    jnius = ModuleType("jnius")
+    jnius.autoclass = lambda name: {"android.os.Process": fake}[name]
+    monkeypatch.setitem(sys.modules, "jnius", jnius)
+    monkeypatch.setattr(android, "running_on_android", lambda: True)
+    return calls
+
+
+def test_boosts_to_audio_priority_on_android(process):
+    android.boost_current_thread("render")
+    assert process == [-16]
+
+
+def test_noop_off_android(process, monkeypatch):
+    monkeypatch.setattr(android, "running_on_android", lambda: False)
+    android.boost_current_thread("render")
+    assert process == []
+
+
+def test_failure_is_logged_not_raised(process, monkeypatch, caplog):
+    def refuse(priority):
+        raise RuntimeError("java.lang.SecurityException")
+
+    sys.modules["jnius"].autoclass = lambda name: SimpleNamespace(
+        THREAD_PRIORITY_AUDIO=-16, setThreadPriority=refuse
+    )
+    with caplog.at_level(logging.ERROR):
+        android.boost_current_thread("event loop")
+    assert "event loop thread priority" in caplog.text
+
+
+def test_render_loop_and_event_loop_boost_themselves():
+    from ledfx.core import LedFxCore
+    from ledfx.virtuals import Virtual
+
+    assert 'boost_current_thread("render")' in inspect.getsource(
+        Virtual.thread_function
+    )
+    start = inspect.getsource(LedFxCore.start)
+    assert start.index('boost_current_thread("event loop")') < start.index(
+        "self.loop.run_forever()"
+    )
