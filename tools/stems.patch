+        for j in range(i + 1, len(STEM_NAMES)):
+            delta = np.abs(out[i] - out[j]).max()
+            assert (
+                delta > 1e-3
+            ), f"{STEM_NAMES[i]} and {STEM_NAMES[j]} are near-identical"
