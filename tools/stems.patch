+@_SKIP
+def test_stems_sum_back_to_the_input(graph):
+    """Conservation: whatever the split quality, energy must not be invented."""
+    hop = 2048
+    x = _tone_mix(hop)
+    out = _separate(graph, x, hop)
+    target = x[:, MODEL_CONTEXT : MODEL_CONTEXT + hop]
+    error = np.sqrt(((out.sum(axis=0) - target) ** 2).mean()) / np.sqrt(
+        (target**2).mean()
+    )
+    _LOGGER.info("reconstruction relative RMS error: %.4f", error)
+    assert error < 0.25, f"stems do not reconstruct the input ({error:.3f})"
+
