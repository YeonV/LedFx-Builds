+@_SKIP
+def test_separator_delivers_blocks_end_to_end(real_config_dir):
+    """Plumbing: fed audio must come back out of read() at MIC_RATE."""
+    import time
+
+    sep = StemSeparator(real_config_dir, hop=2048, threads=4)
+    assert sep.acquire(["drums"])
+    try:
+        mix = _tone_mix(hop=2048 * 4).T  # (samples, 2)
+        for i in range(0, len(mix) - 800, 800):
+            sep.feed(
+                np.ascontiguousarray(mix[i : i + 800]).reshape(-1),
+                2,
+                MODEL_RATE,
+            )
+
+        deadline = time.time() + 20
+        blocks = []
+        while time.time() < deadline and len(blocks) < 4:
+            block = sep.read(["drums"], "full", 500)
+            if block is None:
+                time.sleep(0.05)
+                continue
+            assert len(block) == 500
+            blocks.append(block)
+
+        assert len(blocks) >= 4, f"only {len(blocks)} blocks delivered"
+        assert np.isfinite(np.concatenate(blocks)).all()
+    finally:
+        sep.release(["drums"])
+        assert not sep.running
+
