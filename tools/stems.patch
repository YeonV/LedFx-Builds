+def test_bands_of_the_same_stem_get_separate_buffers(config_dir):
+    """read() consumes, so two bands sharing a stem must not steal from each
+    other - that is the whole reason the band is part of the separator key."""
+    sep = StemSeparator(config_dir)
+    full = canonical_selection(["drums"], "full")
+    high = canonical_selection(["drums"], "high")
+    sep._refcounts[full] = 1
+    sep._refcounts[high] = 1
+    for _ in range(4):
+        sep._publish(full, np.zeros(2048, dtype=np.float32))
+        sep._publish(high, np.zeros(2048, dtype=np.float32))
+
+    a = sep.read(["drums"], "full", 500)
+    b = sep.read(["drums"], "high", 500)
+    assert a is not None and b is not None
+    # draining one must leave the other untouched
+    before = len(sep._out[high])
+    sep.read(["drums"], "full", 500)
+    assert len(sep._out[high]) == before
