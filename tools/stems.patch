--- /dev/null
+++ b/ledfx/effects/stems.py
@@ -0,0 +1,786 @@
+"""Real-time stem separation.
+
+Runs a causal HS-TasNet model (ONNX) over the incoming audio so that effects can
+react to a single instrument group rather than the whole mix: drums on one
+strip, bass on another.
+
+Why this is affordable at all: LedFx *analyses* audio, it never plays it back.
+Nothing listens to the separated stems, so we do not need the glitch-free
+512-sample output chunk a DJ plugin needs. The model burns a fixed 2048-sample
+context per call, so enlarging the hop amortises that cost - measured on a
+desktop CPU, a 512-sample hop runs at 0.66x realtime-per-core while a
+1024-sample hop runs at 0.35x and a 2048-sample hop at 0.20x. We take the
+middle by default: ~43 stem updates per second at roughly a third of one core.
+
+The model is not shipped with LedFx (210 MB). See `ledfx.tools.stem_model`.
+"""
+
+import logging
+import math
+import os
+import threading
+import time
+from collections import deque
+
+import aubio
+import numpy as np
+import samplerate
+
+from ledfx.effects.math import ExpFilter
+from ledfx.effects.melbank import MIC_RATE, Melbanks
+
+_LOGGER = logging.getLogger(__name__)
+
+# Model output order, fixed by the exported graph.
+STEM_NAMES = ("drums", "bass", "vocals", "other")
+
+# The model was trained at 44.1 kHz and is not rate-agnostic; feeding it another
+# rate shifts every timbre it learned. Always resample to this.
+MODEL_RATE = 44100
+
+# Samples of lookaround the model needs on each side of the useful output. The
+# right-hand half is unavoidable algorithmic latency (~23 ms).
+MODEL_CONTEXT = 1024
+
+VALID_HOPS = (512, 1024, 2048)
+
+# Plugin-equivalent input conditioning: normalise towards -12 dBFS so the model
+# sees the level it was trained on, then undo the gain so stem dynamics survive.
+_TARGET_RMS = 0.251
+_MAX_GAIN = 100.0
+_SILENCE_RMS = 10 ** (-72 / 20)
+
+
+# Analysis bands, applied to a stem before it reaches the melbanks.
+#
+# This exists because the melbank normalises by its own loudest bin
+# (melbank.py: filter_banks /= mel_gain) *after* peak isolation has squared the
+# ratios. On a kick-heavy drum stem the kick owns that maximum, so hats land in
+# the floor: measured, the 3-10kHz melbank average is 0.0035 as-is and 0.153
+# once the kick is filtered out first - a 44x difference on identical audio.
+# Restricting a virtual's frequency range cannot fix that, because the
+# normalisation happens before the range is sliced.
+#
+# Cutoffs match the band edges the power functions already use, so "high" here
+# lines up with the "High" power function.
+STEM_BANDS = {
+    "full": (None, None),
+    "low": (None, 250.0),
+    "mid": (250.0, 3000.0),
+    "high": (3000.0, None),
+}
+STEM_BAND_NAMES = tuple(STEM_BANDS)
+
+
+def canonical_band(value):
+    """Normalise a band name, falling back to the unfiltered stem."""
+    return value if value in STEM_BANDS else "full"
+
+
+def canonical_selection(stems, band="full"):
+    """A hashable (stems, band) key.
+
+    The band has to be part of this key rather than living only on the analysis
+    chain: reading from the separator consumes samples, so two chains sharing a
+    stem selection would each get half the audio. Keying the separator's output
+    by band gives every consumer its own buffer.
+    """
+    return (canonical_stems(stems), canonical_band(band))
+
+
+def selection_label(selection):
+    """Human-readable name for a (stems, band) selection, for logs."""
+    stems, band = selection
+    if not stems:
+        # a band only exists inside the separator, so it cannot apply to the mix
+        return "mix"
+    base = "+".join(stems)
+    return base if band == "full" else f"{base} {band}"
+
+
+def _biquad(kind, cutoff_hz, samplerate, q=0.707):
+    """Second-order low- or high-pass, in aubio's coefficient order."""
+    w0 = 2 * math.pi * cutoff_hz / samplerate
+    alpha = math.sin(w0) / (2 * q)
+    cos_w0 = math.cos(w0)
+    if kind == "low":
+        b0, b1, b2 = (1 - cos_w0) / 2, 1 - cos_w0, (1 - cos_w0) / 2
+    else:
+        b0, b1, b2 = (1 + cos_w0) / 2, -(1 + cos_w0), (1 + cos_w0) / 2
+    a0, a1, a2 = 1 + alpha, -2 * cos_w0, 1 - alpha
+    return (b0 / a0, b1 / a0, b2 / a0, a1 / a0, a2 / a0)
+
+
+def _build_band_filters(band, samplerate):
+    """Stateful filter chain for a band. Empty list for the unfiltered band."""
+    high_pass, low_pass = STEM_BANDS[canonical_band(band)]
+    filters = []
+    for kind, cutoff in (("high", high_pass), ("low", low_pass)):
+        if cutoff is None:
+            continue
+        f = aubio.digital_filter(3)
+        f.set_biquad(*_biquad(kind, cutoff, samplerate))
+        filters.append(f)
+    return filters
+
+
+def canonical_stems(value):
+    """Normalise a stem selection to a canonical, hashable key.
+
+    Selections are sets, not sequences: picking drums+bass is the same channel
+    as bass+drums, and the tuple is what keys the analysis chains, so it has to
+    be order- and duplicate-independent or the same channel gets built twice.
+
+    An empty selection means the unseparated mix - the default, and free.
+    """
+    if value is None:
+        return ()
+    if isinstance(value, str):
+        value = [value]
+    return tuple(sorted({s for s in value if s in STEM_NAMES}))
+
+
+def stem_selection_validator(value):
+    """Config validator for a stem selection.
+
+    Named rather than a lambda: the schema serialiser dispatches on the
+    function name to emit a multiselect widget for the frontend.
+    """
+    return list(canonical_stems(value))
+
+
+def stems_label(stems):
+    """Human-readable name for a selection, for logs."""
+    return "+".join(stems) if stems else "mix"
+
+
+def model_dir(config_dir):
+    """Directory holding the separation model inside the LedFx config dir."""
+    return os.path.join(config_dir, "stem_model")
+
+
+def model_path(config_dir):
+    """Path to the ONNX graph. Its external weights sit alongside it."""
+    return os.path.join(model_dir(config_dir), "model.onnx")
+
+
+def model_available(config_dir):
+    """True if we could actually separate right now."""
+    if not os.path.isfile(model_path(config_dir)):
+        return False
+    try:
+        import onnxruntime  # noqa: F401
+    except ImportError:
+        return False
+    return True
+
+
+def unavailable_reason(config_dir):
+    """Human-readable reason separation is off, or None if it is available."""
+    try:
+        import onnxruntime  # noqa: F401
+    except ImportError:
+        return (
+            "onnxruntime is not installed. Install LedFx with the 'stems' "
+            "extra to enable stem separation."
+        )
+    if not os.path.isfile(model_path(config_dir)):
+        return (
+            f"Separation model not found at {model_path(config_dir)}. "
+            "Run 'python -m ledfx.tools.stem_model' to download it."
+        )
+    return None
+
+
+class StemSeparator:
+    """Separates the live audio stream into stems on a worker thread.
+
+    The audio callback only ever appends to a buffer; inference runs elsewhere
+    so a slow frame can never stall capture. Consumers pull mono samples at
+    MIC_RATE via :meth:`read`, matching the rest of the audio pipeline.
+
+    Stems are reference counted - we only pay for the ones effects ask for, and
+    the worker idles entirely when nothing wants a separated stem.
+    """
+
+    def __init__(self, config_dir, hop=1024, threads=4):
+        self._config_dir = config_dir
+        self._hop = hop if hop in VALID_HOPS else 1024
+        self._threads = threads
+        self._window = self._hop + 2 * MODEL_CONTEXT
+
+        self._session = None
+        self._thread = None
+        self._running = False
+        self._wake = threading.Event()
+        self._lock = threading.Lock()
+
+        # Input side: stereo @ MODEL_RATE, primed with left context.
+        self._in_buf = np.zeros((MODEL_CONTEXT, 2), dtype=np.float32)
+        self._in_resampler = None
+        self._in_rate = None
+        self._in_cap = MODEL_RATE * 2
+
+        # Output side: mono @ MIC_RATE per stem.
+        self._out = {}
+        self._out_resamplers = {}
+        self._band_filters = {}
+        self._out_cap = MIC_RATE
+
+        self._refcounts = {}
+        self._warned_mono = False
+
+    # -- lifecycle ---------------------------------------------------------
+
+    def open(self):
+        """Load the model. Returns True if separation is usable."""
+        if self._session is not None:
+            return True
+
+        reason = unavailable_reason(self._config_dir)
+        if reason:
+            _LOGGER.warning("Stem separation unavailable: %s", reason)
+            return False
+
+        import onnxruntime as ort
+
+        options = ort.SessionOptions()
+        # Keep inference off the audio path and off every core: LedFx still has
+        # devices to render to.
+        options.intra_op_num_threads = self._threads
+        options.inter_op_num_threads = 1
+        options.graph_optimization_level = (
+            ort.GraphOptimizationLevel.ORT_ENABLE_ALL
+        )
+        try:
+            self._session = ort.InferenceSession(
+                model_path(self._config_dir),
+                options,
+                providers=["CPUExecutionProvider"],
+            )
+        except Exception as exc:
+            _LOGGER.error("Failed to load stem separation model: %s", exc)
+            self._session = None
+            return False
+
+        _LOGGER.info(
+            "Stem separation model loaded (hop %s samples, %.1f ms per update)",
+            self._hop,
+            self._hop / MODEL_RATE * 1000,
+        )
+        return True
+
+    def start(self):
+        if self._running or not self.open():
+            return self._running
+        self._running = True
+        self._thread = threading.Thread(
+            target=self._worker, name="StemSeparator", daemon=True
+        )
+        self._thread.start()
+        return True
+
+    def stop(self):
+        self._running = False
+        self._wake.set()
+        thread = self._thread
+        if thread and thread.is_alive():
+            thread.join(timeout=2)
+        self._thread = None
+        with self._lock:
+            self._in_buf = np.zeros((MODEL_CONTEXT, 2), dtype=np.float32)
+            self._out.clear()
+            self._out_resamplers.clear()
+            self._band_filters.clear()
+
+    # -- selection reference counting ---------------------------------------
+
+    def acquire(self, stems, band="full"):
+        """Register interest in a selection. Starts the worker on first use.
+
+        Keyed by the whole selection, not by individual stems: the model emits
+        every stem in one pass anyway, so a combination costs only the summing,
+        one band filter, one resample and one melbank set.
+        """
+        selection = canonical_selection(stems, band)
+        if not selection[0]:
+            return False
+        with self._lock:
+            self._refcounts[selection] = self._refcounts.get(selection, 0) + 1
+            first = self._refcounts[selection] == 1
+        if first:
+            _LOGGER.debug(
+                "Stem selection '%s' acquired", selection_label(selection)
+            )
+        return self.start()
+
+    def release(self, stems, band="full"):
+        selection = canonical_selection(stems, band)
+        if not selection[0]:
+            return
+        with self._lock:
+            if selection not in self._refcounts:
+                return
+            self._refcounts[selection] -= 1
+            if self._refcounts[selection] <= 0:
+                del self._refcounts[selection]
+                self._out.pop(selection, None)
+                self._out_resamplers.pop(selection, None)
+                self._band_filters.pop(selection, None)
+            idle = not self._refcounts
+        if idle:
+            _LOGGER.debug("No stems in use, stopping separator")
+            self.stop()
+
+    @property
+    def active_stems(self):
+        with self._lock:
+            return tuple(self._refcounts)
+
+    @property
+    def running(self):
+        return self._running
+
+    # -- producer side (audio callback) ------------------------------------
+
+    def feed(self, interleaved, channels, samplerate_in):
+        """Append captured audio. Called from the audio callback - cheap only.
+
+        `interleaved` is the flattened frame as it arrives from the stream, so
+        stereo is L,R,L,R. Anything other than 2 channels is spread to stereo,
+        which the model tolerates poorly for everything but drums.
+        """
+        if not self._running:
+            return
+
+        frames = np.asarray(interleaved, dtype=np.float32)
+        if channels >= 2:
+            frames = frames.reshape(-1, channels)[:, :2]
+        else:
+            if not self._warned_mono:
+                self._warned_mono = True
+                _LOGGER.warning(
+                    "Stem separation is running on a mono input. The model "
+                    "relies on stereo cues: drums separate correctly but "
+                    "bass, vocals and other will be unreliable. Select a "
+                    "stereo (WASAPI loopback) input for usable stems."
+                )
+            frames = np.repeat(frames.reshape(-1, 1), 2, axis=1)
+
+        if samplerate_in != MODEL_RATE:
+            if self._in_resampler is None or self._in_rate != samplerate_in:
+                self._in_resampler = samplerate.Resampler(
+                    "sinc_fastest", channels=2
+                )
+                self._in_rate = samplerate_in
+            frames = self._in_resampler.process(
+                frames, MODEL_RATE / samplerate_in
+            ).astype(np.float32)
+
+        if not len(frames):
+            return
+
+        with self._lock:
+            self._in_buf = np.concatenate((self._in_buf, frames))
+            # Drop the oldest audio rather than grow without bound if the
+            # worker cannot keep up.
+            if len(self._in_buf) > self._in_cap:
+                self._in_buf = self._in_buf[-self._in_cap :]
+            ready = len(self._in_buf) >= self._window
+        if ready:
+            self._wake.set()
+
+    # -- consumer side (per render frame) ----------------------------------
+
+    def read(self, stems, band, count):
+        """Pop `count` mono samples at MIC_RATE, or None if not yet available."""
+        selection = canonical_selection(stems, band)
+        with self._lock:
+            buf = self._out.get(selection)
+            if buf is None or len(buf) < count:
+                return None
+            self._out[selection] = buf[count:]
+            return buf[:count]
+
+    # -- worker ------------------------------------------------------------
+
+    def _worker(self):
+        while self._running:
+            if not self._wake.wait(timeout=0.5):
+                continue
+            self._wake.clear()
+            while self._running:
+                window = self._take_window()
+                if window is None:
+                    break
+                try:
+                    self._process(window)
+                except Exception:
+                    _LOGGER.exception("Stem separation failed, stopping")
+                    self._running = False
+                    break
+
+    def _take_window(self):
+        """Claim one inference window, advancing the buffer by one hop."""
+        with self._lock:
+            if len(self._in_buf) < self._window:
+                return None
+            window = self._in_buf[: self._window].copy()
+            self._in_buf = self._in_buf[self._hop :]
+            return window
+
+    def _process(self, window):
+        wanted = self.active_stems
+        if not wanted:
+            return
+
+        # (frames, 2) -> (1, 2, frames)
+        x = np.ascontiguousarray(window.T)[None]
+
+        rms = float(np.sqrt(np.mean(np.square(x))))
+        gain = min(_TARGET_RMS / rms, _MAX_GAIN) if rms > _SILENCE_RMS else 1.0
+
+        out = self._session.run(None, {"audio": (x * gain).astype(np.float32)})
+        # (1, stems, channels, samples) -> useful centre hop only
+        stems = out[0][0][:, :, MODEL_CONTEXT : MODEL_CONTEXT + self._hop]
+        stems = stems / gain
+
+        for selection in wanted:
+            idx = [STEM_NAMES.index(s) for s in selection[0]]
+            signal = stems[idx].sum(axis=0)
+            self._publish(selection, signal.mean(axis=0))
+
+    def _publish(self, selection, mono):
+        """Band-limit, resample to MIC_RATE, and hand to the consumer.
+
+        The band filter runs here, before the melbanks ever see the signal,
+        which is the whole point: it changes what the melbank's auto-gain
+        normalises against.
+        """
+        mono = np.ascontiguousarray(mono, dtype=np.float32)
+
+        if selection not in self._band_filters:
+            self._band_filters[selection] = _build_band_filters(
+                selection[1], MODEL_RATE
+            )
+        for band_filter in self._band_filters[selection]:
+            mono = band_filter(mono)
+
+        resampler = self._out_resamplers.get(selection)
+        if resampler is None:
+            resampler = samplerate.Resampler("sinc_fastest", channels=1)
+            self._out_resamplers[selection] = resampler
+
+        resampled = resampler.process(mono, MIC_RATE / MODEL_RATE).astype(
+            np.float32
+        )
+
+        with self._lock:
+            if selection not in self._refcounts:
+                return
+            existing = self._out.get(selection)
+            buf = (
+                resampled
+                if existing is None
+                else np.concatenate((existing, resampled))
+            )
+            # A consumer that stopped reading must not leak memory. Keeping the
+            # newest audio also keeps latency bounded after a render stall.
+            if len(buf) > self._out_cap:
+                buf = buf[-self._out_cap :]
+            self._out[selection] = buf
+
+
+class StemAnalysisChain:
+    """A miniature analysis pipeline for one stem selection.
+
+    Duck-types enough of :class:`AudioAnalysisSource` that effects can be handed
+    one of these instead of the mix source and keep working unchanged: melbanks
+    and the frequency-power family are recomputed from the selection, while
+    anything not stem-specific falls through to the mix.
+
+    That fall-through is deliberate for tempo, onset, pitch and the oscillators.
+    The beat grid should come from the whole track - a bass strip still wants to
+    know where the beat is, and estimating tempo from an isolated stem is worse
+    than estimating it from the mix.
+    """
+
+    def __init__(self, ledfx, stems, source, band="full"):
+        # Set first: __getattr__ reads it, so it must exist before anything else
+        # can miss an attribute lookup.
+        self._source = source
+        self._ledfx = ledfx
+        self.selection = canonical_selection(stems, band)
+        self.stems, self.band = self.selection
+        self.label = selection_label(self.selection)
+        # Melbanks reads min_volume off the audio object it is bound to.
+        self._config = {"min_volume": source._config["min_volume"]}
+
+        fft_size = source._config["fft_size"]
+        self._frame_len = MIC_RATE // source._config["sample_rate"]
+        self._phase_vocoder = aubio.pvoc(fft_size, self._frame_len)
+        self._frequency_domain_null = aubio.cvec(fft_size)
+        self._frequency_domain = self._frequency_domain_null
+
+        self._sample = np.zeros(self._frame_len, dtype=np.float32)
+        self._volume = 0.0
+
+        # Per-selection frequency powers, mirroring AudioAnalysisSource so the
+        # POWER_FUNCS_MAPPING effects react to the selection, not the mix.
+        self.freq_power_raw = np.zeros(len(source.freq_max_mels))
+        self.freq_power_filter = ExpFilter(
+            np.zeros(len(source.freq_max_mels)),
+            alpha_decay=0.2,
+            alpha_rise=0.97,
+        )
+
+        # Onset, tempo and pitch detectors of our own. An isolated drum stem is
+        # a better tempo and onset source than the mix, which is the whole reason
+        # to do this rather than proxying to the mix as the melbank-only version
+        # did. Note the corollary: a *melodic* selection is a worse beat source
+        # than the mix, and its grid will free-run more.
+        fft_params = (fft_size, self._frame_len, MIC_RATE)
+        self._onset_detector = aubio.onset(
+            source._config["onset_method"], *fft_params
+        )
+        self._tempo_detector = aubio.tempo(
+            source._config["tempo_method"], *fft_params
+        )
+        self._pitch_detector = aubio.pitch(
+            source._config["pitch_method"], *fft_params
+        )
+        self._pitch_detector.set_unit("midi")
+        self._pitch_detector.set_tolerance(source._config["pitch_tolerance"])
+
+        # Beat grid state, per selection. Free-runs on the last known period
+        # when the stem goes quiet, so a sparse selection degrades to a steady
+        # grid rather than stalling.
+        self.beat_counter = 0
+        self.beat_timestamp = time.time()
+        self.beat_period = 2
+
+        # Volume-based beat detection state. The thresholds are read off the
+        # source, but the history and last-beat time must be ours.
+        self.beat_power_history = deque(maxlen=source.beat_power_history_len)
+        self.beat_prev_time = time.time()
+
+        # Recomputed at most once per frame, and only if something reads them.
+        self._frame_cache = {}
+        self._fresh = False
+
+        # Deferred: creating the melbanks costs filterbank construction, so we
+        # only do it once something actually reads this chain.
+        self._melbanks = None
+
+    def __getattr__(self, name):
+        """Fall through to the mix source for anything not stem-specific."""
+        source = self.__dict__.get("_source")
+        if source is None:
+            raise AttributeError(name)
+        return getattr(source, name)
+
+    @property
+    def melbanks(self):
+        if self._melbanks is None:
+            self._melbanks = Melbanks(
+                self._ledfx,
+                self,
+                self._ledfx.config.get("melbanks", {}),
+                publish=False,
+            )
+        return self._melbanks
+
+    def volume(self, filtered=True):
+        return self._volume
+
+    def frequency_domain(self):
+        return self._frequency_domain
+
+    def audio_sample(self, raw=False):
+        return self._sample
+
+    def freq_power(self):
+        """Recompute this selection's band powers. Mirrors AudioAnalysisSource."""
+        melbank = self.melbanks.melbanks[2]
+        indexes = self._source.freq_mel_indexes
+
+        self.freq_power_raw[0] = np.average(melbank[: indexes[0]])
+        self.freq_power_raw[1] = np.average(melbank[indexes[0] : indexes[1]])
+        self.freq_power_raw[2] = np.average(melbank[indexes[1] : indexes[2]])
+        self.freq_power_raw[3] = np.average(melbank[indexes[2] : indexes[3]])
+        np.minimum(self.freq_power_raw, 1, out=self.freq_power_raw)
+        self.freq_power_filter.update(self.freq_power_raw)
+
+    def get_freq_power(self, i, filtered=True):
+        if filtered:
+            value = self.freq_power_filter.value[i]
+        else:
+            value = self.freq_power_raw[i]
+        return value if not np.isnan(value) else 0.0
+
+    def beat_power(self, filtered=True):
+        return self.get_freq_power(0, filtered)
+
+    def bass_power(self, filtered=True):
+        return self.get_freq_power(1, filtered)
+
+    def lows_power(self, filtered=True):
+        return (
+            self.get_freq_power(0, filtered) + self.get_freq_power(1, filtered)
+        ) * 0.5
+
+    def mids_power(self, filtered=True):
+        return self.get_freq_power(2, filtered)
+
+    def high_power(self, filtered=True):
+        return self.get_freq_power(3, filtered)
+
+    # -- onset, tempo and pitch --------------------------------------------
+    #
+    # Computed lazily and cached for the frame: an effect may read these several
+    # times per frame, and a chain nothing reads should cost nothing.
+
+    def _per_frame(self, key, compute, default):
+        if not self._fresh:
+            return default
+        if key not in self._frame_cache:
+            try:
+                self._frame_cache[key] = compute()
+            except ValueError as exc:
+                # aubio raises on a malformed buffer; do not let one bad frame
+                # take down the render loop.
+                _LOGGER.warning("Stem '%s' analysis: %s", self.label, exc)
+                self._frame_cache[key] = default
+        return self._frame_cache[key]
+
+    def onset(self):
+        """True when this selection has a transient right now.
+
+        Materially different from the mix onset - measured on real music, a
+        drums-stem onset coincides with a mix onset only ~12% of the time, so
+        this is a genuinely separate trigger rather than the same one relabelled.
+
+        It is not surgical, though. Separation leaves transient residue in every
+        stem, so a hard drum hit still shows up in `other` (~85% of drums onsets
+        have an `other` onset within 33 ms). Expect drum-weighted, not drum-only.
+        """
+        return self._per_frame(
+            "onset",
+            lambda: bool(self._onset_detector(self._sample)[0]),
+            False,
+        )
+
+    def pitch(self):
+        """Pitch of this selection, in MIDI note numbers."""
+        return self._per_frame(
+            "pitch", lambda: self._pitch_detector(self._sample)[0], 0
+        )
+
+    def bpm_beat_now(self):
+        """True when this selection's beat tracker expects a beat now."""
+        return self._per_frame(
+            "tempo",
+            lambda: bool(self._tempo_detector(self._sample)[0]),
+            False,
+        )
+
+    def volume_beat_now(self):
+        """Beat detection from the low-band energy of this selection."""
+        return self._per_frame("volume_beat", self._compute_volume_beat, False)
+
+    def _compute_volume_beat(self):
+        time_now = time.time()
+        melbank = self.melbanks.melbanks[0][: self._source.beat_max_mel_index]
+        beat_power = np.sum(melbank)
+        melbank_max = np.max(melbank) if len(melbank) else 0
+
+        history_sum = sum(self.beat_power_history)
+        if history_sum > 0:
+            difference = (
+                beat_power * self._source.beat_power_history_len / history_sum
+                - 1
+            )
+        else:
+            difference = 0
+
+        self.beat_power_history.appendleft(beat_power)
+
+        if (
+            difference >= self._source.beat_min_percent_diff
+            and melbank_max >= self._source.beat_min_amplitude
+            and time_now - self.beat_prev_time
+            > self._source.beat_min_time_since
+        ):
+            self.beat_prev_time = time_now
+            return True
+        return False
+
+    def bar_oscillator(self):
+        """Position in the musical bar (0<=x<4) according to this selection.
+
+        Same algorithm as the mix, driven by this selection's beat tracker, so a
+        drums strip follows the drums rather than the whole mix.
+        """
+        # Must be computed at most once per frame: it advances the beat counter,
+        # and bpm_beat_now is frame-cached, so a second read in the same frame
+        # would step the bar twice. Not gated on freshness - a starved frame
+        # still needs the oscillator to free-run rather than snap to zero.
+        if "bar" not in self._frame_cache:
+            self._frame_cache["bar"] = self._compute_bar_oscillator()
+        return self._frame_cache["bar"]
+
+    def _compute_bar_oscillator(self):
+        if self.bpm_beat_now():
+            self.beat_counter = (self.beat_counter + 1) % 4
+            self.beat_period = self._tempo_detector.get_period_s()
+            self.beat_timestamp = time.time()
+            return self.beat_counter
+
+        time_since_beat = time.time() - self.beat_timestamp
+        oscillator = (
+            1 - (self.beat_period - time_since_beat) / self.beat_period
+        ) + self.beat_counter
+        # keep it in [0, 4) - matters when the stem drops out
+        return oscillator % 4
+
+    def beat_oscillator(self):
+        """Position within the current beat (0<=x<1) for this selection."""
+        return self.bar_oscillator() % 1
+
+    def update(self, separator):
+        """Advance this chain by one render frame."""
+        self._frame_cache.clear()
+
+        block = separator.read(self.stems, self.band, self._frame_len)
+        if block is None:
+            # Starved: decay towards silence rather than freeze the last frame,
+            # so a stalled separator fades the strip out instead of latching.
+            # Detectors are deliberately not fed - pushing a stale or zero
+            # buffer through aubio would manufacture phantom onsets. The beat
+            # oscillator keeps free-running on its last period instead.
+            self._fresh = False
+            self._volume *= 0.9
+            if self._volume < 0.01:
+                self._frequency_domain = self._frequency_domain_null
+            return False
+
+        block = np.nan_to_num(block)
+        self._sample = block
+        self._volume = max(0.0, min(1.0, 1 + aubio.db_spl(block) / 100))
+
+        # A stem that is essentially absent from the track is mostly separation
+        # residue, and an onset detector will happily fire on that noise -
+        # measured at nearly twice the mix onset rate on a stem holding under 5%
+        # of the energy. Below the volume gate we report no transients at all,
+        # which is also what the melbank path does with the frequency domain.
+        above_gate = self._volume > self._config["min_volume"]
+        self._fresh = above_gate
+
+        if above_gate:
+            self._frequency_domain = self._phase_vocoder(block)
+        else:
+            self._frequency_domain = self._frequency_domain_null
+
+        self.melbanks()
+        self.freq_power()
+        return True
