+"""Tests for real-time stem separation.
+
+The separation model is a ~210 MB optional download, so the tests that need it
+skip when it is absent. Everything that can be tested without it - graceful
+degradation, buffer bounds, reference counting, schema wiring - always runs.
+"""
+
+import logging
+import time
+
+import numpy as np
+import pytest
+
+from ledfx.effects.audio import AudioReactiveEffect
+from ledfx.effects.stems import (
+    MODEL_CONTEXT,
+    STEM_BAND_NAMES,
+    MODEL_RATE,
+    STEM_NAMES,
+    VALID_HOPS,
+    StemAnalysisChain,
+    StemSeparator,
+    _build_band_filters,
+    canonical_band,
+    canonical_selection,
+    canonical_stems,
+    model_available,
+    model_path,
+    selection_label,
+    stems_label,
+    unavailable_reason,
+)
+
+_LOGGER = logging.getLogger(__name__)
+
+FRAME_HZ = 60
+
+
+class FakeSource:
+    """Minimal stand-in for AudioAnalysisSource."""
+
+    _config = {
+        "min_volume": 0.2,
+        "fft_size": 4096,
+        "sample_rate": FRAME_HZ,
+        "onset_method": "hfc",
+        "tempo_method": "default",
+        "pitch_method": "yinfft",
+        "pitch_tolerance": 0.8,
+    }
+    freq_max_mels = [100, 250, 3000, 10000]
+    freq_mel_indexes = [2, 5, 17, 23]
+    # volume-beat thresholds, read off the source by each chain
+    beat_max_mel_index = 3
+    beat_power_history_len = 12
+    beat_min_percent_diff = 0.5
+    beat_min_time_since = 0.1
+    beat_min_amplitude = 0.5
+
+
+class FakeEvents:
+    def __init__(self):
+        self.fired = []
+
+    def fire_event(self, event):
+        self.fired.append(event)
+
+
+class FakeLedfx:
+    def __init__(self, config_dir="."):
+        self.config = {"melbanks": {}}
+        self.config_dir = config_dir
+        self.events = FakeEvents()
+
+    def dev_enabled(self):
+        return False
+
+
+@pytest.fixture
+def config_dir(tmp_path):
+    return str(tmp_path)
+
+
+# ---------------------------------------------------------------------------
+# Wiring
+# ---------------------------------------------------------------------------
+
+
+def test_every_audio_effect_gains_a_stem_selector():
+    """The selector lives on the base class so all effects inherit it."""
+    schema = AudioReactiveEffect.get_combined_default_schema()
+    assert schema["stems"] == [], "default is the unseparated mix"
+
+
+def test_real_effects_inherit_the_selector():
+    from ledfx.effects.bands import BandsAudioEffect
+    from ledfx.effects.energy import EnergyAudioEffect
+
+    for effect in (BandsAudioEffect, EnergyAudioEffect):
+        assert effect.get_combined_default_schema()["stems"] == []
+
+
+def test_schema_emits_a_multiselect_widget():
+    from ledfx.api.utils import convertToJsonSchema
+    from ledfx.effects.bands import BandsAudioEffect
+
+    prop = convertToJsonSchema(BandsAudioEffect.schema())["properties"][
+        "stems"
+    ]
+    assert prop["type"] == "multiselect"
+    assert prop["enum"] == list(STEM_NAMES)
+    assert prop["default"] == []
+
+
+def test_selection_is_order_and_duplicate_independent():
+    """The tuple keys the analysis chains, so it must be canonical or the same
+    channel gets built twice."""
+    assert canonical_stems(["bass", "drums"]) == canonical_stems(
+        ["drums", "bass"]
+    )
+    assert canonical_stems(["drums", "drums"]) == ("drums",)
+
+
+def test_selection_drops_unknown_stems():
+    assert canonical_stems(["nonsense", "bass"]) == ("bass",)
+    assert canonical_stems(["mix"]) == (), "mix is not a stem, it is no stems"
+
+
+def test_empty_selection_means_the_mix():
+    for empty in (None, [], (), "", ["mix"]):
+        assert canonical_stems(empty) == ()
+    assert stems_label(()) == "mix"
+    assert stems_label(("bass", "drums")) == "bass+drums"
+
+
+# ---------------------------------------------------------------------------
+# Graceful degradation - LedFx must run normally with no model installed
+# ---------------------------------------------------------------------------
+
+
+def test_unavailable_reason_names_the_missing_model(config_dir):
+    reason = unavailable_reason(config_dir)
+    assert reason is not None
+    assert "stem_model" in reason or "onnxruntime" in reason
+
+
+def test_separator_without_model_stays_off(config_dir):
+    sep = StemSeparator(config_dir)
+    assert sep.open() is False
+    assert sep.start() is False
+    assert sep.running is False
+    # Acquiring a stem must not raise, it just cannot deliver one.
+    assert sep.acquire(["drums"]) is False
+    assert sep.read(["drums"], "full", 500) is None
+
+
+def test_feed_before_start_is_a_noop(config_dir):
+    """The audio callback calls feed() unconditionally; it must never raise."""
+    sep = StemSeparator(config_dir)
+    sep.feed(np.zeros(1600, dtype=np.float32), 2, 48000)
+    assert sep.read(["drums"], "full", 10) is None
+
+
+def test_empty_and_unknown_selections_are_never_acquired(config_dir):
+    sep = StemSeparator(config_dir)
+    assert sep.acquire([]) is False
+    assert sep.acquire(["nonsense"]) is False
+    # release of an unheld selection must be harmless
+    sep.release([])
+    sep.release(["nonsense"])
+    sep.release(["drums"])
+
+
+def test_invalid_hop_falls_back_to_default(config_dir):
+    assert StemSeparator(config_dir, hop=999)._hop == 1024
+    for hop in VALID_HOPS:
+        assert StemSeparator(config_dir, hop=hop)._hop == hop
+
+
+# ---------------------------------------------------------------------------
+# Buffering - a stalled or absent consumer must not leak memory
+# ---------------------------------------------------------------------------
+
+
+def test_input_buffer_is_bounded(config_dir):
+    sep = StemSeparator(config_dir)
+    sep._running = True  # buffer without needing a model
+    try:
+        for _ in range(200):
+            sep.feed(np.zeros(4800, dtype=np.float32), 2, 48000)
+        assert len(sep._in_buf) <= sep._in_cap
+    finally:
+        sep._running = False
+
+
+def test_output_buffer_is_bounded(config_dir):
+    sep = StemSeparator(config_dir)
+    key = canonical_selection(["drums"])
+    sep._refcounts[key] = 1
+    for _ in range(400):
+        sep._publish(key, np.zeros(2048, dtype=np.float32))
+    assert len(sep._out[key]) <= sep._out_cap
+
+
+def test_mono_input_is_spread_to_stereo_with_one_warning(config_dir, caplog):
+    sep = StemSeparator(config_dir)
+    sep._running = True
+    try:
+        with caplog.at_level(logging.WARNING):
+            for _ in range(3):
+                sep.feed(np.zeros(800, dtype=np.float32), 1, MODEL_RATE)
+        assert sep._in_buf.shape[1] == 2
+        warnings = [r for r in caplog.records if "mono input" in r.message]
+        assert len(warnings) == 1, "should warn once, not every frame"
+    finally:
+        sep._running = False
+
+
+def test_feed_resamples_to_model_rate(config_dir):
+    sep = StemSeparator(config_dir)
+    sep._running = True
+    try:
+        before = len(sep._in_buf)
+        # one 48k frame of 800 samples -> ~735 samples at 44.1k
+        sep.feed(np.zeros(1600, dtype=np.float32), 2, 48000)
+        added = len(sep._in_buf) - before
+        assert 700 < added < 770, added
+    finally:
+        sep._running = False
+
+
+def test_read_returns_none_until_enough_samples(config_dir):
+    sep = StemSeparator(config_dir)
+    key = canonical_selection(["bass"])
+    sep._refcounts[key] = 1
+    sep._publish(key, np.zeros(100, dtype=np.float32))
+    # 100 samples at 44.1k becomes ~68 at MIC_RATE, short of a 500 frame
+    assert sep.read(["bass"], "full", 500) is None
+    sep._publish(key, np.zeros(2048, dtype=np.float32))
+    block = sep.read(["bass"], "full", 500)
+    assert block is not None and len(block) == 500
+
+
+# ---------------------------------------------------------------------------
+# Analysis chain
+# ---------------------------------------------------------------------------
+
+
+def test_chain_proxies_genuinely_shared_attributes_to_the_mix():
+    """Only things with no per-stem meaning fall through."""
+    source = FakeSource()
+    source.some_shared_thing = lambda: "from-mix"
+    chain = StemAnalysisChain(FakeLedfx(), ["drums"], source)
+    assert chain.some_shared_thing() == "from-mix"
+
+
+def test_beat_analysis_is_the_stems_own_not_proxied():
+    """onset/pitch/tempo/oscillators must be computed from the stem, since an
+    isolated drum track is a better beat source than the mix."""
+    source = FakeSource()
+    for name in (
+        "onset",
+        "pitch",
+        "bpm_beat_now",
+        "volume_beat_now",
+        "bar_oscillator",
+        "beat_oscillator",
+    ):
+        # a proxy would find the source attribute; these must not exist there
+        assert not hasattr(source, name), f"{name} would be proxied"
+        assert callable(
+            getattr(StemAnalysisChain, name)
+        ), f"{name} missing from the chain"
+
+
+def test_starved_frame_reports_no_onset_and_free_runs_the_bar():
+    """A stalled separator must not manufacture transients, but the bar has to
+    keep moving or bar-synced effects would freeze."""
+    chain = StemAnalysisChain(FakeLedfx(), ["drums"], FakeSource())
+    sep = StemSeparator(".")
+    chain.beat_period = 0.5
+
+    assert chain.update(sep) is False
+    assert chain.onset() is False
+    assert chain.pitch() == 0
+    assert chain.bpm_beat_now() is False
+
+    first = chain.bar_oscillator()
+    time.sleep(0.05)
+    chain._frame_cache.clear()
+    assert chain.bar_oscillator() != first, "bar must keep advancing"
+
+
+def test_bar_oscillator_steps_once_per_frame():
+    """It advances the beat counter and bpm_beat_now is frame-cached, so two
+    reads in one frame must not step the bar twice."""
+    chain = StemAnalysisChain(FakeLedfx(), ["drums"], FakeSource())
+    chain._fresh = True
+    chain._frame_cache["tempo"] = True  # pretend a beat landed this frame
+
+    before = chain.beat_counter
+    values = {chain.bar_oscillator() for _ in range(5)}
+    assert chain.beat_counter == (before + 1) % 4, "stepped more than once"
+    assert len(values) == 1, "must be stable within a frame"
+
+
+def test_frame_cache_is_cleared_between_frames():
+    chain = StemAnalysisChain(FakeLedfx(), ["drums"], FakeSource())
+    chain._frame_cache["onset"] = True
+    chain.update(StemSeparator("."))
+    assert "onset" not in chain._frame_cache
+
+
+def test_power_family_is_the_stems_own():
+    source = FakeSource()
+    chain = StemAnalysisChain(FakeLedfx(), ["drums"], source)
+    assert chain.bass_power is not source.__class__.__dict__.get("bass_power")
+
+
+def test_chain_starves_towards_silence_rather_than_latching(config_dir):
+    sep = StemSeparator(config_dir)
+    chain = StemAnalysisChain(FakeLedfx(), ["drums"], FakeSource())
+    chain._volume = 1.0
+    for _ in range(60):
+        assert chain.update(sep) is False
+    assert chain._volume < 0.01, "a stalled separator must fade, not hold"
+
+
+def test_chain_melbanks_do_not_touch_shared_config():
+    """Stem melbanks must not fight the mix melbanks over config or graphs."""
+    ledfx = FakeLedfx()
+    ledfx.config["melbank_collection"] = []
+    chain = StemAnalysisChain(ledfx, ["drums"], FakeSource())
+    melbanks = chain.melbanks
+    melbanks()
+    assert ledfx.config["melbank_collection"] == [], "must not publish"
+    assert "melbanks" in ledfx.config and ledfx.config["melbanks"] == {}
+    assert ledfx.events.fired == [], "must not emit graph events"
+
+
+# ---------------------------------------------------------------------------
+# Effect-side routing
+# ---------------------------------------------------------------------------
+
+
+class FakeAudio:
+    """Records chain acquire/release so leaks are visible."""
+
+    def __init__(self, available=True):
+        self.available = available
+        self.acquired = []
+        self.released = []
+        self.melbanks = "mix-melbanks"
+        self._stem_generation = 0
+
+    def stem_chain(self, stems, band="full"):
+        selection = canonical_selection(stems, band)
+        if not self.available or not selection[0]:
+            return None
+        self.acquired.append(selection)
+        chain = type(
+            "Chain",
+            (),
+            {
+                "stems": selection[0],
+                "band": selection[1],
+                "selection": selection,
+                "melbanks": f"{selection_label(selection)}-melbanks",
+            },
+        )
+        return chain()
+
+    def release_stem(self, stems, band="full"):
+        self.released.append(canonical_selection(stems, band))
+
+
+def _effect(stems):
+    """An AudioReactiveEffect stub with only the attributes routing touches."""
+    effect = AudioReactiveEffect.__new__(AudioReactiveEffect)
+    effect._config = {"stems": list(stems), "stem_band": "full"}
+    effect._stem_chain = None
+    effect._stem_current = None
+    effect._stem_generation = -1
+    effect.audio = FakeAudio()
+    return effect
+
+
+def test_empty_selection_reads_the_mix_melbanks():
+    effect = _effect([])
+    effect._sync_stem_chain()
+    assert effect._melbank_source == "mix-melbanks"
+    assert effect.audio.acquired == [], "the mix must not acquire a chain"
+
+
+def test_stem_effect_reads_its_own_melbanks():
+    effect = _effect(["drums"])
+    effect._sync_stem_chain()
+    assert effect._melbank_source == "drums-melbanks"
+    assert effect.audio.acquired == [canonical_selection(["drums"])]
+
+
+def test_multiple_stems_resolve_to_one_summed_chain():
+    """drums+bass is a single channel, not two."""
+    effect = _effect(["drums", "bass"])
+    effect._sync_stem_chain()
+    assert effect.audio.acquired == [canonical_selection(["bass", "drums"])]
+    assert effect._melbank_source == "bass+drums-melbanks"
+
+
+def test_reordering_the_selection_does_not_rebuild_the_chain():
+    """Config order must not churn chains every time the UI reorders chips."""
+    effect = _effect(["drums", "bass"])
+    effect._sync_stem_chain()
+    effect._config["stems"] = ["bass", "drums"]
+    effect._sync_stem_chain()
+    assert effect.audio.acquired == [canonical_selection(["bass", "drums"])]
+    assert effect.audio.released == []
+
+
+def test_switching_selection_releases_the_previous_one():
+    effect = _effect(["drums"])
+    effect._sync_stem_chain()
+    effect._config["stems"] = ["bass"]
+    effect._sync_stem_chain()
+    assert effect.audio.acquired == [
+        canonical_selection(["drums"]),
+        canonical_selection(["bass"]),
+    ]
+    assert effect.audio.released == [
+        canonical_selection(["drums"])
+    ], "old chain must be released"
+    assert effect._melbank_source == "bass-melbanks"
+
+
+def test_syncing_the_same_selection_twice_is_a_noop():
+    """Called every audio frame, so it must not churn chains."""
+    effect = _effect(["drums"])
+    for _ in range(10):
+        effect._sync_stem_chain()
+    assert effect.audio.acquired == [canonical_selection(["drums"])]
+    assert effect.audio.released == []
+
+
+def test_clearing_the_selection_releases_the_chain():
+    effect = _effect(["drums"])
+    effect._sync_stem_chain()
+    effect._config["stems"] = []
+    effect._sync_stem_chain()
+    assert effect.audio.released == [canonical_selection(["drums"])]
+    assert effect._melbank_source == "mix-melbanks"
+
+
+def test_unavailable_separation_falls_back_to_the_mix(caplog):
+    """No model installed must degrade to normal behaviour, not break."""
+    effect = _effect(["drums"])
+    effect.audio = FakeAudio(available=False)
+    effect.NAME = "Test"
+    with caplog.at_level(logging.WARNING):
+        effect._sync_stem_chain()
+    assert effect._melbank_source == "mix-melbanks"
+    assert any(
+        "falling back to the full mix" in r.message for r in caplog.records
+    )
+
+
+def test_enabling_separation_later_reaches_existing_effects():
+    """The bug this guards: an effect that fell back to the mix because no model
+    was installed must pick up separation once it is enabled, without the user
+    having to touch the stem dropdown."""
+    effect = _effect(["drums"])
+    effect.NAME = "Test"
+    effect.audio = FakeAudio(available=False)
+    effect._sync_stem_chain()
+    assert effect._melbank_source == "mix-melbanks", "starts on the mix"
+
+    # separation comes up; AudioAnalysisSource.initialise_stems bumps this
+    effect.audio.available = True
+    effect.audio._stem_generation += 1
+    effect._sync_stem_chain()
+    assert effect._melbank_source == "drums-melbanks"
+    assert effect.audio.acquired == [canonical_selection(["drums"])]
+
+
+def test_failed_resolve_is_not_retried_every_frame():
+    """Retrying a missing model 60x a second would be a performance disaster."""
+    effect = _effect(["drums"])
+    effect.NAME = "Test"
+    effect.audio = FakeAudio(available=False)
+    calls = []
+    original = effect.audio.stem_chain
+
+    def counted(stems, band="full"):
+        calls.append((stems, band))
+        return original(stems, band)
+
+    effect.audio.stem_chain = counted
+    for _ in range(30):
+        effect._sync_stem_chain()
+    assert len(calls) == 1, f"resolved {len(calls)} times, expected 1"
+
+
+def test_release_is_idempotent():
+    effect = _effect(["drums"])
+    effect._sync_stem_chain()
+    effect._release_stem_chain()
+    effect._release_stem_chain()
+    assert effect.audio.released == [
+        canonical_selection(["drums"])
+    ], "must not double-release"
