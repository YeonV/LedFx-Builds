+def _separate(graph, stereo, hop=2048):
+    """Run one window and return the useful centre, shape (stems, 2, hop)."""
+    rms = float(np.sqrt(np.mean(np.square(stereo))))
+    gain = min(0.251 / rms, 100.0) if rms > 10 ** (-72 / 20) else 1.0
+    out = graph.run(None, {"audio": (stereo * gain)[None].astype(np.float32)})
+    return out[0][0][:, :, MODEL_CONTEXT : MODEL_CONTEXT + hop] / gain
+
+
+def _tone_mix(hop=2048, seed=0):
+    window = hop + 2 * MODEL_CONTEXT
+    rng = np.random.default_rng(seed)
+    t = np.arange(window) / MODEL_RATE
+    sig = (
+        0.2 * np.sin(2 * np.pi * 110 * t)
+        + 0.1 * np.sin(2 * np.pi * 880 * t)
+        + rng.normal(0, 0.05, window)
+    )
+    return np.stack([sig, sig]).astype(np.float32)
+
+
+@_SKIP
+def test_silence_in_silence_out(graph):
+    """A quiet input must not hallucinate stems, or idle strips will flicker."""
+    window = 2048 + 2 * MODEL_CONTEXT
+    out = _separate(graph, np.zeros((2, window), dtype=np.float32))
+    assert np.abs(out).max() < 1e-3, np.abs(out).max()
+
