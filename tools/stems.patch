+"""Download the stem separation model.
+
+The model is ~210 MB, so it is not shipped with LedFx. It is fetched from the
+StemgenRT repository (MIT licensed), where it is stored via Git LFS.
+
+    python -m ledfx.tools.stem_model
+
+Note on provenance: the StemgenRT repository is MIT licensed and the weights are
+committed to it, but the repository does not document what the model was trained
+on. If that matters for your use, ask upstream before redistributing it.
+"""
+
+import argparse
+import hashlib
+import json
+import logging
+import os
+import sys
+import urllib.request
+
+from ledfx.config import get_default_config_directory
+from ledfx.effects.stems import model_dir, model_path
+
+LFS_ENDPOINT = "https://github.com/sweetspotsoundsystem/stemgen-rt.git/info/lfs/objects/batch"
+
+# oid/size pairs from the repository's LFS pointer files.
+OBJECTS = {
+    "model.onnx": {
+        "oid": "3e6432f8704c44ed61f9709296acea07112913a62cc7465b1ea44071197f58b1",
+        "size": 497166,
+    },
+    "model.onnx.data": {
+        "oid": "355f036eb618a03b878e01e5da1b4b0e5463c725c4cb2ed18f94888003c7d722",
+        "size": 210763776,
+    },
+}
+
+
+def _resolve_urls():
+    """Ask the LFS batch API where the objects actually live."""
+    payload = json.dumps(
+        {
+            "operation": "download",
+            "transfers": ["basic"],
+            "objects": [
+                {"oid": o["oid"], "size": o["size"]} for o in OBJECTS.values()
+            ],
+        }
+    ).encode()
+
+    request = urllib.request.Request(
+        LFS_ENDPOINT,
+        data=payload,
+        headers={
+            "Accept": "application/vnd.git-lfs+json",
+            "Content-Type": "application/vnd.git-lfs+json",
+        },
+    )
+    with urllib.request.urlopen(request, timeout=30) as response:
+        body = json.load(response)
+
+    by_oid = {}
+    for entry in body.get("objects", []):
+        href = entry.get("actions", {}).get("download", {}).get("href")
+        if not href:
+            raise RuntimeError(
+                f"LFS gave no download URL for {entry.get('oid')}: "
+                f"{entry.get('error')}"
+            )
+        by_oid[entry["oid"]] = href
+    return by_oid
+
+
+def _download(url, target, expected_oid, expected_size):
+    digest = hashlib.sha256()
+    written = 0
+    partial = target + ".part"
+
+    with urllib.request.urlopen(url, timeout=60) as response:
+        with open(partial, "wb") as handle:
+            while True:
+                block = response.read(1 << 20)
+                if not block:
+                    break
+                handle.write(block)
+                digest.update(block)
+                written += len(block)
+                if expected_size:
+                    percent = 100 * written / expected_size
+                    print(
+                        f"\r  {os.path.basename(target)}: {percent:5.1f}% "
+                        f"({written / 1e6:.0f}/{expected_size / 1e6:.0f} MB)",
+                        end="",
+                        flush=True,
+                    )
+    print()
+
+    if written != expected_size:
+        os.remove(partial)
+        raise RuntimeError(
+            f"{target}: expected {expected_size} bytes, got {written}"
+        )
+    if digest.hexdigest() != expected_oid:
+        os.remove(partial)
+        raise RuntimeError(f"{target}: checksum mismatch, refusing to install")
+
+    os.replace(partial, target)
+
+
+def download(config_dir, force=False):
+    """Fetch the model into the LedFx config directory. Returns True on success."""
+    destination = model_dir(config_dir)
+    os.makedirs(destination, exist_ok=True)
+
+    if os.path.isfile(model_path(config_dir)) and not force:
+        print(f"Model already present at {model_path(config_dir)}")
+        print("Pass --force to download it again.")
+        return True
+
+    print("Resolving download URLs...")
+    urls = _resolve_urls()
+
+    for name, meta in OBJECTS.items():
+        target = os.path.join(destination, name)
+        url = urls.get(meta["oid"])
+        if not url:
+            raise RuntimeError(f"No URL resolved for {name}")
+        _download(url, target, meta["oid"], meta["size"])
+
+    print(f"\nModel installed to {destination}")
+    print("Enable it in LedFx: Settings -> Audio -> stem separation.")
+    return True
+
+
+def main():
+    logging.basicConfig(level=logging.INFO)
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "-c",
+        "--config",
+        dest="config_dir",
+        default=None,
+        help="LedFx configuration directory",
+    )
+    parser.add_argument(
+        "--force",
+        action="store_true",
+        help="Re-download even if the model is already present",
+    )
+    args = parser.parse_args()
+
+    config_dir = args.config_dir or get_default_config_directory()
+    try:
+        download(config_dir, force=args.force)
+    except Exception as exc:
+        print(f"Download failed: {exc}", file=sys.stderr)
+        return 1
+
+    try:
+        import onnxruntime  # noqa: F401
+    except ImportError:
+        print(
+            "\nWarning: onnxruntime is not installed, so separation cannot run "
+            "yet.\nInstall it with:  pip install 'ledfx[stems]'",
+            file=sys.stderr,
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
