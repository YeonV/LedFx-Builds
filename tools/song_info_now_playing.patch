@@ -0,0 +1,107 @@
+"""song_info websocket messages feed Now Playing when it is on."""
+
+import os
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from ledfx.api.websocket import (
+    WebsocketConnection,
+    song_info_artwork,
+    song_info_to_now_playing,
+)
+from ledfx.assets import get_assets_directory
+from ledfx.events import Event
+from ledfx.nowplaying.models import TrackMetadata
+from ledfx.nowplaying.service import NowPlayingService
+from tests.test_now_playing_opt_in import _Ledfx, _png
+
+
+@pytest.fixture
+def ledfx(tmp_path):
+    return _Ledfx(config_dir=str(tmp_path))
+
+
+@pytest.fixture
+def service(ledfx):
+    svc = NowPlayingService(ledfx)
+    svc._art_resolver = MagicMock()
+    return svc
+
+
+def _cover(ledfx, name="current_album_art.png"):
+    assets = get_assets_directory(ledfx.config_dir)
+    os.makedirs(assets, exist_ok=True)
+    path = os.path.join(assets, name)
+    with open(path, "wb") as file:
+        file.write(_png())
+    return path
+
+
+def _song(**extra):
+    return {"id": 1, "type": "song_info", "title": "Song", "artist": "Artist", **extra}
+
+
+def test_text_only_sets_the_track(service, ledfx):
+    song_info_to_now_playing(service, ledfx.config_dir, _song(position=3, playing=True))
+    metadata = service.get_current().metadata
+    assert metadata.title == "Song" and metadata.position == 3.0 and metadata.playing
+    events = ledfx.events.of(Event.SONG_DETECTED)
+    assert len(events) == 1 and events[-1].thumbnail is None
+
+
+def test_relative_asset_path_becomes_the_cover(service, ledfx):
+    _cover(ledfx)
+    song_info_to_now_playing(
+        service, ledfx.config_dir, _song(thumbnail="current_album_art.png")
+    )
+    assert service.get_current().artwork is not None
+    assert ledfx.events.of(Event.SONG_DETECTED)[-1].thumbnail == (
+        "now_playing/now_playing.png"
+    )
+
+
+def test_absolute_path_inside_assets_is_accepted(ledfx):
+    path = _cover(ledfx)
+    artwork = song_info_artwork(ledfx.config_dir, path)
+    assert artwork is not None and artwork[1] == "image/png"
+
+
+def test_path_outside_assets_is_ignored(ledfx, tmp_path):
+    outside = tmp_path / "secret.png"
+    outside.write_bytes(_png())
+    assert song_info_artwork(ledfx.config_dir, str(outside)) is None
+    assert song_info_artwork(ledfx.config_dir, "../secret.png") is None
+
+
+def test_native_provider_keeps_priority(service, ledfx):
+    service.set_metadata("smtc", TrackMetadata(source_id="smtc", title="Native"))
+    song_info_to_now_playing(service, ledfx.config_dir, _song())
+    assert service.get_current().metadata.title == "Native"
+
+
+def _connection(enabled):
+    events = MagicMock()
+    now_playing = SimpleNamespace(enabled=enabled)
+    ledfx = SimpleNamespace(events=events, now_playing=now_playing, config_dir="/x")
+    return SimpleNamespace(_ledfx=ledfx), events
+
+
+def test_disabled_now_playing_keeps_the_plain_relay():
+    connection, events = _connection(enabled=False)
+    WebsocketConnection.song_info_handler(connection, _song())
+    fired = events.fire_event.call_args.args[0]
+    assert fired.event_type == Event.SONG_DETECTED and fired.title == "Song"
+
+
+def test_enabled_now_playing_does_not_double_the_event(monkeypatch):
+    routed = []
+    monkeypatch.setattr(
+        "ledfx.api.websocket.song_info_to_now_playing",
+        lambda now_playing, config_dir, message: routed.append(message),
+    )
+    connection, events = _connection(enabled=True)
+    WebsocketConnection.song_info_handler(connection, _song())
+    assert len(routed) == 1
+    events.fire_event.assert_not_called()
