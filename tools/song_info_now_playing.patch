+SONG_INFO_SOURCE = "song_info"
+_SONG_INFO_MAX_ARTWORK = 10 * 1024 * 1024
+
+
+def song_info_artwork(config_dir: str, thumbnail: object) -> tuple[bytes, str] | None:
+    """Read the cover a song_info message points at, if it lies in the assets dir.
+
+    The desktop song detector writes the file into the assets directory and
+    sends its absolute path; an uploader (POST /api/assets) sends the relative
+    asset path. Anything resolving outside the assets directory is ignored, so a
+    websocket client cannot make the core read arbitrary files.
+    """
+    if not isinstance(thumbnail, str) or not thumbnail:
+        return None
+    relative = thumbnail
+    if os.path.isabs(relative):
+        try:
+            relative = os.path.relpath(
+                os.path.realpath(relative),
+                os.path.realpath(get_assets_directory(config_dir)),
+            )
+        except ValueError:  # different drive on Windows
+            return None
+    valid, absolute, _error = resolve_safe_asset_path(config_dir, relative)
+    if not valid or absolute is None or not os.path.isfile(absolute):
+        _LOGGER.debug("song_info thumbnail not usable: %s", thumbnail)
+        return None
+    content_type = mimetypes.guess_type(absolute)[0]
+    if content_type is None or not content_type.startswith("image/"):
+        return None
+    if os.path.getsize(absolute) > _SONG_INFO_MAX_ARTWORK:
+        return None
+    with open(absolute, "rb") as file:
+        return file.read(), content_type
+
+
+def _float_or_none(value: object) -> float | None:
+    if isinstance(value, bool) or not isinstance(value, int | float | str):
+        return None
+    try:
+        return float(value)
+    except ValueError:
+        return None
+
+
+def song_info_to_now_playing(
+    now_playing: "NowPlayingService", config_dir: str, message: Mapping[str, object]
+) -> None:
+    """Feed a song_info message into Now Playing like any other provider.
+
+    The service then keeps the state for /api/now-playing, extracts gradients,
+    applies album art and emits song_detected itself.
+    """
+    from ledfx.nowplaying.models import TrackMetadata
+
+    def text(key: str) -> str | None:
+        value = message.get(key)
+        return value if isinstance(value, str) and value else None
+
+    playing = message.get("playing")
+    artwork = song_info_artwork(config_dir, message.get("thumbnail"))
+    track = TrackMetadata(
+        source_id=SONG_INFO_SOURCE,
+        title=text("title"),
+        artist=text("artist"),
+        album=text("album"),
+        position=_float_or_none(message.get("position")),
+        duration=_float_or_none(message.get("duration")),
+        playing=playing if isinstance(playing, bool) else None,
+    )
+    now_playing.set_metadata(
+        SONG_INFO_SOURCE, track, has_own_artwork=artwork is not None
+    )
+    if artwork is not None:
+        now_playing.set_artwork_bytes(SONG_INFO_SOURCE, *artwork)
+
