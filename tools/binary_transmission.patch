diff --git a/tests/test_transmission_mode.py b/tests/test_transmission_mode.py
index a6a515f..1728093 100644
--- a/tests/test_transmission_mode.py
+++ b/tests/test_transmission_mode.py
@@ -35,3 +35,57 @@ def test_build_step(version, mode, expected):
 
 def test_files_are_written_at_the_newest_build_step():
     assert LEGACY_CONFIGURATION_VERSION == BUILD_CONFIGURATION_VERSION
+
+
+def test_binary_is_the_default():
+    from ledfx.configuration.models import LedFxConfig
+
+    assert LedFxConfig().transmission_mode == "binary_rgb"
+
+
+def test_binary_frame_matches_the_frontend_decoder():
+    import struct
+
+    from ledfx.api.websocket import binary_vis_frame
+
+    pixels = bytes(range(12))
+    frame = binary_vis_frame(
+        {"id": 7, "pixels": pixels, "shape": (2, 2), "is_device": True}
+    )
+    assert struct.unpack("<BBBBIHH", frame[:12]) == (0x4C, 1, 1, 3, 7, 2, 2)
+    assert frame[12:] == pixels
+
+
+def test_oversized_dimension_raises_struct_error():
+    import struct
+
+    from ledfx.api.websocket import binary_vis_frame
+
+    with pytest.raises(struct.error):
+        binary_vis_frame({"id": 1, "pixels": b"\0" * 3, "shape": (1, 70000)})
+
+
+def test_upstream_compressed_file_is_migrated_once(tmp_path):
+    import json
+
+    from ledfx.configuration.store import ConfigStore
+
+    (tmp_path / "config.json").write_text(
+        json.dumps(
+            {
+                "schema_version": 2,
+                "configuration_version": "2.3.6",
+                "transmission_mode": "compressed",
+            }
+        )
+    )
+    store = ConfigStore.load(str(tmp_path))
+    assert store.data.transmission_mode == "binary_rgb"
+    on_disk = json.loads((tmp_path / "config.json").read_text())
+    assert on_disk["transmission_mode"] == "binary_rgb"
+    assert on_disk["configuration_version"] == LEGACY_CONFIGURATION_VERSION
+    assert list(tmp_path.glob("config_backup_VERSION_*"))
+
+    store.data.transmission_mode = "compressed"
+    store.save_now()
+    assert ConfigStore.load(str(tmp_path)).data.transmission_mode == "compressed"
