+# Binary vis frame: 12-byte little-endian header, then raw pixel bytes.
+#   0 magic  1 version  2 flags (bit0 = is_device)  3 bytes-per-pixel
+#   4:8 subscription id  8:10 rows  10:12 cols
+# The subscription id is what routes the frame client-side - a binary frame
+# has no JSON envelope to carry event_type/vis_id, and the client already
+# knows which id it registered for which virtual.
+VIS_BINARY_MAGIC = 0x4C
+VIS_BINARY_VERSION = 1
+VIS_BINARY_HEADER = "<BBBBIHH"
 MAX_VAL = 32767
 
 # Phase 2: Client metadata constants
