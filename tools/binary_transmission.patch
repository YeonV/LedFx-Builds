+            if isinstance(pixels, (bytes, bytearray)):
+                rows, cols = message.get("shape") or (1, 0)
+                count = rows * cols
+                header = struct.pack(
+                    VIS_BINARY_HEADER,
+                    VIS_BINARY_MAGIC,
+                    VIS_BINARY_VERSION,
+                    1 if message.get("is_device") else 0,
+                    len(pixels) // count if count else 0,
+                    int(message.get("id", 0)),
+                    int(rows),
+                    int(cols),
+                )
+                self._vis_slots[vis_id] = header + bytes(pixels)
